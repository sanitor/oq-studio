import { SegmentedControl } from "segmented_control.slint";
import { ActionIcon, ActionSymbol, ToolButton } from "action_button.slint";
import { CheckBox } from "std-widgets.slint";
import { LineEdit } from "compact_widgets.slint";
import { Theme } from "../theme.slint";

export struct CorrectorField { key: string, label: string, stage: string, tool: string, value: float, text: string, minimum: float, maximum: float, wheel-x: float, wheel-y: float }
export struct CorrectorStage { key: string, label: string, active: bool }

// Pointer and keyboard share exactly the same transaction intents. RGB entries
// remain available below the wheel for precision, accessibility and neutral reset.
component ColorWheel inherits Rectangle {
    in property <string> label;
    in property <string> target;
    in property <string> field-prefix;
    in property <bool> enabled: true;
    callback edit(string, string, string, string);
    width: 152px; height: 174px;
    in-out property <float> position-x;
    in-out property <float> position-y;
    Text { height: 20px; width: parent.width; text: root.label; horizontal-alignment: center; color: Theme.foreground; font-size: 11px; }
    Image { y: 22px; width: 152px; height: 152px; source: @image-url("../assets/corrector-wheel.svg"); }
    Rectangle {
        x: 73px + root.position-x * 67px; y: 95px + root.position-y * 67px;
        width: 7px; height: 7px; border-radius: 4px; border-width: 1px; border-color: #ffffff; background: #24242a;
    }
    focus := FocusScope {
        enabled: root.enabled;
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if !root.enabled { return reject; }
            if event.text == Key.Escape { root.edit(root.target, "cancel", "", ""); return accept; }
            if event.text == Key.Return { root.edit(root.target, "commit", "", ""); return accept; }
            if event.text == Key.LeftArrow || event.text == Key.RightArrow || event.text == Key.UpArrow || event.text == Key.DownArrow {
                root.edit(root.target, "begin", "", "");
                root.position-x = clamp(root.position-x + (event.text == Key.LeftArrow ? -0.02 : event.text == Key.RightArrow ? 0.02 : 0), -1, 1);
                root.position-y = clamp(root.position-y + (event.text == Key.UpArrow ? -0.02 : event.text == Key.DownArrow ? 0.02 : 0), -1, 1);
                root.edit(root.target, "wheel", root.field-prefix, root.position-x + "," + root.position-y);
                root.edit(root.target, "commit", "", ""); return accept;
            }
            return reject;
        }
        hit := TouchArea {
            enabled: root.enabled;
            y: 22px; width: 152px; height: 152px;
            accessible-role: button; accessible-label: root.label + " color wheel; arrow keys adjust, Escape cancels";
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    focus.focus(); root.edit(root.target, "begin", "", "");
                } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                    root.edit(root.target, "commit", "", "");
                } else if event.kind == PointerEventKind.cancel { root.edit(root.target, "cancel", "", ""); }
            }
            moved => {
                if root.enabled && self.pressed {
                    root.position-x = clamp((self.mouse-x / 1px - 76) / 67, -1, 1);
                    root.position-y = clamp((self.mouse-y / 1px - 76) / 67, -1, 1);
                    root.edit(root.target, "wheel", root.field-prefix, root.position-x + "," + root.position-y);
                }
            }
        }
    }
}

export component CorrectorEditor inherits Rectangle {
    in property <string> target;
    in property <[CorrectorField]> fields;
    in property <[CorrectorStage]> stages;
    in property <bool> active;
    in property <bool> busy;
    in property <string> error;
    in property <string> domain;
    callback edit(string, string, string, string);
    private property <string> curve-channel: "master";
    private property <string> palette: "primaries";
    private property <string> primary-tool: "basic";
    private property <string> hdr-tool: "shadows";
    background: Theme.panel;
    vertical-stretch: 0;
    height: content.preferred-height;
    content := VerticalLayout {
        padding: 12px; spacing: 8px;
        HorizontalLayout {
            CheckBox { text: "Corrector enabled"; checked: root.active; enabled: !root.busy; toggled => { root.edit(root.target, "enable", "", self.checked ? "true" : "false"); } }
            ToolButton { label: "Reset Color Corrector"; symbol: ActionSymbol.history; active: !root.busy; clicked => { root.edit(root.target, "reset", "all", ""); } }
        }
        Text { text: root.domain; color: Theme.secondary; font-size: 10px; wrap: word-wrap; }
        if root.stages.length > 0: SegmentedControl {
            option-count: root.stages.length;
            item-height: 24px; label-font-size: 11px;
            selected-key: root.palette;
            dynamic-option(index) => {
                let stage = root.stages[index];
                return {
                    key: stage.key, label: stage.label, accessible-name: "Corrector palette " + stage.label,
                    symbol: stage.key == "primaries" ? ActionSymbol.controls
                        : stage.key == "hdr_zones" ? ActionSymbol.sun
                        : stage.key == "rgb_mixer" ? ActionSymbol.layers
                        : stage.key == "curves" ? ActionSymbol.ease : ActionSymbol.eyedropper,
                };
            }
            selected(key) => { root.palette = key; }
        }
        VerticalLayout {
            spacing: 0px;
            for stage in root.stages: Rectangle {
                height: stage.key == root.palette ? 22px : 0px;
                visible: stage.key == root.palette;
                if stage.key == root.palette: HorizontalLayout {
                    CheckBox { text: stage.label + " enabled"; checked: stage.active; enabled: !root.busy;
                        toggled => { root.edit(root.target, "stage-enable", stage.key, self.checked ? "true" : "false"); } }
                    ToolButton { height: 22px; icon-size: 14px; label: "Reset " + stage.label; symbol: ActionSymbol.history; active: !root.busy;
                        clicked => { root.edit(root.target, "reset", stage.key, ""); } }
                }
            }
        }
        if root.palette == "primaries": SegmentedControl {
            item-height: 24px; label-font-size: 11px;
            options: [
                { key: "basic", label: "Basic", accessible-name: "Corrector primaries Basic", symbol: ActionSymbol.settings },
                { key: "lift", label: "Lift", accessible-name: "Corrector primaries Lift", symbol: ActionSymbol.up },
                { key: "gamma", label: "Gamma", accessible-name: "Corrector primaries Gamma", symbol: ActionSymbol.ease },
                { key: "gain", label: "Gain", accessible-name: "Corrector primaries Gain", symbol: ActionSymbol.fit-view },
                { key: "offset", label: "Offset", accessible-name: "Corrector primaries Offset", symbol: ActionSymbol.move },
            ];
            selected-key: root.primary-tool;
            selected(key) => { root.primary-tool = key; }
        }
        if root.palette == "hdr_zones": SegmentedControl {
            item-height: 24px; label-font-size: 11px;
            options: [
                { key: "blacks", label: "Black", accessible-name: "Corrector zone Black", symbol: ActionSymbol.black-level },
                { key: "shadows", label: "Shadow", accessible-name: "Corrector zone Shadow", symbol: ActionSymbol.shadow-level },
                { key: "darks", label: "Dark", accessible-name: "Corrector zone Dark", symbol: ActionSymbol.dark-level },
                { key: "lights", label: "Light", accessible-name: "Corrector zone Light", symbol: ActionSymbol.light-level },
                { key: "highlights", label: "Highlight", accessible-name: "Corrector zone Highlight", symbol: ActionSymbol.highlight-level },
                { key: "specular", label: "Specular", accessible-name: "Corrector zone Specular", symbol: ActionSymbol.sparkle },
                { key: "ranges", label: "Range / softness", accessible-name: "Corrector zone ranges", symbol: ActionSymbol.fit },
            ];
            selected-key: root.hdr-tool;
            selected(key) => { root.hdr-tool = key; }
        }
        VerticalLayout {
            spacing: 0px;
            for field in root.fields: Rectangle {
                height: root.palette == "primaries" && field.key == root.primary-tool + "_r" ? 174px : 0px;
                visible: self.height > 0px;
                if root.palette == "primaries" && field.key == root.primary-tool + "_r": HorizontalLayout {
                    alignment: center;
                    ColorWheel { label: root.primary-tool == "lift" ? "Lift" : root.primary-tool == "gamma" ? "Gamma" : root.primary-tool == "gain" ? "Gain" : "Offset"; field-prefix: root.primary-tool; target: root.target;
                        position-x: field.wheel-x; position-y: field.wheel-y;
                        enabled: !root.busy; edit(t,a,k,v) => { root.edit(t,a,k,v); } }
                }
            }
        }
        if root.palette == "curves": VerticalLayout {
            SegmentedControl {
                item-height: 24px; label-font-size: 11px;
                options: [
                    { key: "master", label: "Master", accessible-name: "Corrector curve Master", symbol: ActionSymbol.layers },
                    { key: "red", label: "Red", accessible-name: "Corrector curve Red", symbol: ActionSymbol.channel },
                    { key: "green", label: "Green", accessible-name: "Corrector curve Green", symbol: ActionSymbol.channel-green },
                    { key: "blue", label: "Blue", accessible-name: "Corrector curve Blue", symbol: ActionSymbol.channel-blue },
                ];
                selected-key: root.curve-channel;
                selected(key) => { root.curve-channel = key; }
            }
            Text { text: "Exposure offsets around 18% gray. Master and channel offsets combine in stops.";
                wrap: word-wrap; font-size: 10px; color: Theme.secondary; }
        }
        if root.palette == "hdr_zones": Text { text: "Scene-linear luminance zones · ranges and softness in stops. Overlapping zones combine in fixed order."; wrap: word-wrap; font-size: 10px; color: Theme.secondary; }
        VerticalLayout {
            spacing: 0px;
            for field in root.fields: Rectangle {
                height: field.stage == root.palette && field.tool == (root.palette == "primaries" ? root.primary-tool : root.palette == "rgb_mixer" ? "matrix" : root.palette == "curves" ? root.curve-channel : root.palette == "qualifier" ? "qualifier" : root.hdr-tool) ? 46px : 0px;
                visible: self.height > 0px;
                if field.stage == root.palette && field.tool == (root.palette == "primaries" ? root.primary-tool : root.palette == "rgb_mixer" ? "matrix" : root.palette == "curves" ? root.curve-channel : root.palette == "qualifier" ? "qualifier" : root.hdr-tool): VerticalLayout {
                    spacing: 2px;
                Text { text: field.label; color: Theme.secondary; font-size: 10px; overflow: elide; }
                HorizontalLayout {
                    value-focus := FocusScope {
                        horizontal-stretch: 1; height: 22px;
                        key-pressed(event) => { if event.text == Key.Escape { root.edit(root.target, "cancel", "", ""); return accept; } return reject; }
                        LineEdit { width: parent.width; text <=> field.text; accessible-label: "Corrector " + field.label; enabled: !root.busy;
                            edited => { root.edit(root.target, "preview", field.key, self.text); }
                            accepted => { root.edit(root.target, "commit", field.key, self.text); } }
                    }
                    Rectangle {
                        width: 64px; height: 22px; background: Theme.card; border-radius: 3px;
                        ActionIcon {
                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                            width: 14px; height: 14px;
                            symbol: ActionSymbol.slip; stroke: Theme.secondary;
                        }
                        drag := TouchArea {
                            private property <float> baseline;
                            private property <length> start;
                            accessible-role: button; accessible-label: "Drag Corrector " + field.label;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                    self.baseline = field.value; self.start = self.mouse-x; root.edit(root.target, "begin", "", "");
                                } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left { root.edit(root.target, "commit", "", ""); }
                                else if event.kind == PointerEventKind.cancel { root.edit(root.target, "cancel", "", ""); }
                            }
                            moved => { if self.pressed { root.edit(root.target, "preview", field.key, clamp(self.baseline + (self.mouse-x - self.start) / 1px * (field.maximum - field.minimum) / 400, field.minimum, field.maximum) + ""); } }
                        }
                    }
                }
            }
        }
        }
        ToolButton { label: "Apply Color Corrector"; visible-label: "Apply grade"; symbol: ActionSymbol.check; show-label: true; active: !root.busy; clicked => { root.edit(root.target, "commit", "", ""); } }
        if root.error != "": Text { text: root.error; color: #d44747; wrap: word-wrap; font-size: 11px; }
        ToolButton { label: "Cancel Corrector gesture"; visible-label: "Cancel gesture"; symbol: ActionSymbol.close; show-label: true; active: !root.busy; clicked => { root.edit(root.target, "cancel", "", ""); } }
    }
}
