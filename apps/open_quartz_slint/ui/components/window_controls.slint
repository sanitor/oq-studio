import { ActionIcon, ActionSymbol } from "action_button.slint";

// Shared by the graph editor and timeline editor; colors follow the host header.
export component WindowControlButton inherits Rectangle {
    in property <string> action;
    in property <bool> mac-style;
    in property <bool> maximized;
    in property <color> foreground: #1d1d1f;
    in property <color> hover-background: #e5e5e5;
    callback clicked();
    width: root.mac-style ? 14px : 42px;
    height: root.mac-style ? 14px : 40px;
    border-radius: root.mac-style ? 7px : 0px;
    background: root.mac-style
        ? root.action == "close" ? #ff5f57 : root.action == "minimize" ? #febc2e : #28c840
        : area.has-hover ? root.hover-background : transparent;
    accessible-role: button;
    accessible-label: root.action == "close" ? "Close window" : root.action == "minimize" ? "Minimize window" : root.maximized ? "Restore window" : "Maximize window";
    accessible-action-default => { root.clicked(); }
    ActionIcon {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: root.mac-style ? 9px : 13px; height: self.width;
        symbol: root.action == "close" ? ActionSymbol.close
            : root.action == "minimize" ? ActionSymbol.minus
            : root.maximized ? ActionSymbol.restore-window : ActionSymbol.maximize;
        stroke: root.mac-style ? #5b2a20 : root.foreground;
        visible: !root.mac-style || area.has-hover;
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

export component WindowControls inherits Rectangle {
    in property <bool> mac-style;
    in property <bool> maximized;
    in property <color> foreground: #1d1d1f;
    in property <color> hover-background: #e5e5e5;
    callback minimize-window();
    callback toggle-maximize-window();
    callback close-window();
    width: root.mac-style ? 64px : 126px;
    height: 40px;
    HorizontalLayout {
        spacing: root.mac-style ? 7px : 0px;
        for action in root.mac-style ? ["close", "minimize", "maximize"] : ["minimize", "maximize", "close"]: Rectangle {
            width: root.mac-style ? 14px : 42px;
            height: parent.height;
            WindowControlButton {
                y: (parent.height - self.height) / 2;
                action: action;
                mac-style: root.mac-style;
                maximized: root.maximized;
                foreground: root.foreground;
                hover-background: root.hover-background;
                clicked => {
                    if action == "close" { root.close-window(); }
                    else if action == "minimize" { root.minimize-window(); }
                    else { root.toggle-maximize-window(); }
                }
            }
        }
    }
}
