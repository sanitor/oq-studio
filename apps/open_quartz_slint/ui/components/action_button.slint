import { Theme } from "../theme.slint";

export enum ActionSymbol {
    none,
    add,
    track-add,
    transform,
    undo,
    redo,
    folder,
    save,
    save-as,
    link,
    unlink,
    import-file,
    export-file,
    settings,
    previous,
    play,
    pause,
    next,
    split,
    delete,
    minus,
    magnet,
    fit,
    fit-view,
    queue,
    history,
    restore,
    close,
    stop,
    check,
    layers,
    proxy,
    mic,
    cube,
    monitor,
    node,
    compare,
    eye,
    eye-off,
    camera,
    image,
    match,
    mark-in,
    mark-out,
    sync,
    title,
    subtitle,
    subtitle-import,
    subtitle-export,
    insert,
    overwrite,
    ripple-delete,
    slip,
    slide,
    keyframe,
    keyframe-add,
    keyframe-remove,
    ease,
    target,
    copy,
    paste,
    marker-add,
    marker-remove,
    audio,
    file,
    film,
    box,
    code,
    lock,
    unlock,
    up,
    down,
    audio-off,
    solo,
    disclosure-down,
    disclosure-up,
    disclosure-right,
    grip,
    maximize,
    restore-window,
    math,
    warning,
    move,
    edit,
    controls,
    sun,
    eyedropper,
    black-level,
    shadow-level,
    dark-level,
    light-level,
    highlight-level,
    sparkle,
    channel,
    channel-green,
    channel-blue
}

