export component ToolButton inherits Rectangle {
    in property <string> label;
    in property <string> visible-label: root.label;
    in property <string> tooltip-text: root.visible-label;
    in property <ActionSymbol> symbol;
    in property <bool> active: true;
    in property <bool> selected: false;
    in property <bool> show-label: false;
    in property <bool> primary: false;
    in property <length> icon-size: 18px;
    in property <length> label-padding: 8px;
    in property <length> label-font-size: 12px;
    callback clicked();

    min-width: 32px;
    horizontal-stretch: 0;
    max-width: root.show-label ? 10000px : 32px;
    height: 32px;
    border-radius: 5px;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    background: root.primary && root.active ? (touch.has-hover ? #633e94 : #55387a)
        : root.selected ? Theme.graph-active
        : root.active && touch.has-hover ? Theme.card
        : root.show-label ? Theme.panel : transparent;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.active;
    accessible-action-default => { if root.active { root.clicked(); } }

    HorizontalLayout {
        alignment: center;
        cross-axis-alignment: center;
        padding-left: root.show-label ? root.label-padding : 0px;
        padding-right: root.show-label ? root.label-padding : 0px;
        spacing: 6px;
        if root.symbol != ActionSymbol.none: ActionIcon {
            symbol: root.symbol;
            width: root.icon-size; height: root.icon-size;
            stroke: !root.active ? Theme.secondary : root.selected ? Theme.accent-text : Theme.foreground;
            opacity: root.active ? 1 : 0.55;
        }
        if root.show-label: Text {
            text: root.visible-label;
            color: root.active ? Theme.foreground : Theme.secondary;
            opacity: root.active ? 1 : 0.7;
            font-size: root.label-font-size;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    focus := FocusScope {
        enabled: root.active;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { return accept; }
            reject
        }
        key-released(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            reject
        }
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.active;
        mouse-cursor: root.active ? pointer : default;
        clicked => { root.clicked(); }
    }

    Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}
