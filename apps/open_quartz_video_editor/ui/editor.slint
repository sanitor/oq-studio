import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, Slider, TextEdit } from "std-widgets.slint";
import { WindowControls } from "../../open_quartz_slint/ui/components/window_controls.slint";
import { ActionIcon, ActionSymbol, ToolButton } from "../../open_quartz_slint/ui/components/action_button.slint";
import { SegmentedControl } from "../../open_quartz_slint/ui/components/segmented_control.slint";
import { GraphView, GraphNode, GraphEdge, GraphPort } from "../../open_quartz_slint/ui/components/graph_view.slint";
import { Inspector, InspectorPort, InspectorUniform, InspectorFormField, InspectorFormGroup } from "../../open_quartz_slint/ui/components/inspector.slint";
import { CorrectorField, CorrectorStage } from "../../open_quartz_slint/ui/components/corrector_editor.slint";
import { Theme } from "../../open_quartz_slint/ui/theme.slint";
import { CodeEditorBridge } from "code_editor.slint";
export { CodeEditorBridge, GraphNode, GraphEdge, GraphPort, InspectorPort, InspectorUniform, InspectorFormField, InspectorFormGroup, CorrectorField, CorrectorStage }

export struct PipelineEffect { label: string, index: int, thumbnail: image }
export struct PipelineGroup { label: string, effects: [PipelineEffect] }

component NodeEffectTile inherits Rectangle {
    in property <PipelineEffect> effect;
    in property <bool> enabled;
    callback clicked();

    width: 69px;
    height: self.width;
    border-radius: 5px;
    background: #202427;
    clip: true;

    Image {
        width: parent.width;
        height: parent.height;
        source: root.effect.thumbnail;
        image-fit: cover;
        opacity: root.enabled ? 1 : 0.65;
    }
    Rectangle {
        y: parent.height - self.height;
        width: parent.width;
        height: 36px;
        background: @linear-gradient(180deg, #10141800 0%, #101418ed 45%, #101418fa 100%);
        Text {
            x: 3px; y: 10px;
            width: parent.width - 6px; height: parent.height - 12px;
            text: root.effect.label;
            color: #f2f5f6;
            font-size: 10px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
    }
    Rectangle {
        width: parent.width; height: parent.height;
        border-radius: root.border-radius;
        border-width: 1px;
        border-color: tile.has-hover && root.enabled ? Theme.accent : #ffffff32;
    }
    tile := TouchArea {
        accessible-role: button;
        accessible-label: "Add " + root.effect.label + " node";
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Tooltip { text: @markdown("Add \{root.effect.label} node"); }
}
export struct ExportJobRow { path: string, phase: string, details: string, can_cancel: bool, can_retry: bool }
export struct TranscriptRow { index: int, label: string, checked: bool }
export struct AssetRow { id: string, name: string, details: string, online: bool, selected: bool, thumbnail: image, has_thumbnail: bool }
export struct TrackRow { id: string, name: string, selected: bool, visible: bool, locked: bool, sync_ripple: bool, blend_mode: int, subtitles: bool }
export struct AudioTrackRow { id: string, name: string, muted: bool, solo: bool, locked: bool, sync_ripple: bool, gain: string }
export struct AudioClipRow { id: string, lane: int, name: string, start: float, duration: float, description: string, selected: bool, muted: bool, editable: bool, waveform: string, fade_in: float, fade_out: float }
export struct MonitorBox { ax: float, ay: float, bx: float, by: float, cx: float, cy: float, dx: float, dy: float, tx: float, ty: float, angle: float, visible: bool, locked: bool }
export struct ClipRow { id: string, lane: int, track: string, locked: bool, asset_name: string, is_title: bool, is_subtitle: bool, is_still: bool, start: int, duration: int, x: float, width: float, selected: bool, online: bool, thumbnail: image, has_thumbnail: bool }
export struct SnapResult { delta: int, frame: int }
export struct MotionKeyRow { index: int, frame: int, selected: bool }
export struct MarkerRow { frame: int, name: string }
export struct DissolveRow { lane: int, start: float, duration: float, description: string }


component AssetCard inherits Rectangle {
    in property <AssetRow> asset;
    callback clicked();
    callback add_clicked(string);
    callback dropped(string, length, length);
    height: 76px; background: root.asset.selected ? #352b46 : #202427; border-radius: 6px;
    accessible-role: button;
    accessible-label: root.asset.name;
    accessible-description: root.asset.details + (root.asset.online ? "; online" : "; offline");
    Rectangle {
        x: 7px; y: 8px; width: 88px; height: 60px; background: #101214; border-radius: 4px; clip: true;
        if root.asset.has_thumbnail: Image { width: parent.width; height: parent.height; source: root.asset.thumbnail; image-fit: cover; }
        if !root.asset.has_thumbnail: ActionIcon {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 24px; height: 24px;
            symbol: root.asset.online ? ActionSymbol.play : ActionSymbol.warning;
            stroke: root.asset.online ? #b486ff : #ff7373;
        }
    }
    Text { x: 102px; y: 7px; width: parent.width - 136px; height: 18px; text: root.asset.name; color: root.asset.online ? #e4e8eb : #ff7373; font-size: 12px; font-weight: 600; overflow: elide; }
    Text { x: 102px; y: 27px; width: parent.width - 136px; height: 30px; text: root.asset.details; color: #8e979d; font-size: 11px; wrap: word-wrap; overflow: elide; }
    Rectangle { x: 102px; y: 63px; width: 5px; height: 5px; border-radius: 3px; background: root.asset.online ? #bd9be7 : #fa7373; }
    Text { x: 112px; y: 58px; width: 90px; height: 16px; text: root.asset.online ? "Ready" : "Offline"; color: root.asset.online ? #bd9be7 : #fa7373; font-size: 11px; }
    card_hit := TouchArea {
        width: parent.width - 30px; height: parent.height;
        private property <length> start_x;
        private property <length> start_y;
        private property <bool> armed;
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel { self.armed = false; }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.start_x = self.mouse-x;
                self.start_y = self.mouse-y;
                self.armed = true;
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && self.armed {
                self.armed = false;
                if abs(self.mouse-x - self.start_x) > 5px || abs(self.mouse-y - self.start_y) > 5px {
                    root.dropped(root.asset.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                } else { root.clicked(); }
            }
        }
    }
    ToolButton {
        x: parent.width - 31px; y: (parent.height - self.height) / 2;
        min-width: 30px; width: 30px;
        label: "Add " + root.asset.name + " to timeline";
        symbol: ActionSymbol.add;
        clicked => { root.add_clicked(root.asset.id); }
    }
}

// Capture absolute pointer coordinates so moving the preview under the pointer
// cannot feed its own displacement back into the gesture. Only release commits.
component ClipGestureArea inherits TouchArea {
    out property <bool> additive;
    in property <float> zoom: 16;
    in property <int> cancel_token;
    callback began();
    callback preview(int, length, length);
    callback finished(int, length, length);
    in property <length> scroll_x;
    private property <length> origin_scroll;
    callback cancelled();
    private property <bool> armed: false;
    private property <length> origin_x;
    changed cancel_token => { self.armed = false; root.cancelled(); }
    pointer-event(event) => {
        if event.kind == PointerEventKind.cancel {
            self.armed = false;
            root.cancelled();
        } else if event.button == PointerEventButton.left {
            if event.kind == PointerEventKind.down {
                self.additive = event.modifiers.shift;
                self.origin_x = self.absolute-position.x + self.mouse-x;
                self.origin_scroll = root.scroll_x;
                self.armed = true;
                root.began();
            } else if event.kind == PointerEventKind.up && self.armed {
                self.armed = false;
                root.finished(Math.round((self.absolute-position.x + self.mouse-x - self.origin_x + self.origin_scroll - root.scroll_x) / 1px / max(0.0001, root.zoom)), self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    moved => {
        if self.pressed && self.armed {
            root.preview(Math.round((self.absolute-position.x + self.mouse-x - self.origin_x + self.origin_scroll - root.scroll_x) / 1px / max(0.0001, root.zoom)), self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
    }
}

component AudioTimelineClip inherits Rectangle {
    in property <AudioClipRow> item;
    in property <int> video_lanes;
    in property <float> zoom;
    in property <int> cancel_token;
    in property <length> scroll_x;
    callback capture();
    callback clicked();
    callback cancelled();
    callback gesture(string, int);
    callback autoscroll(length, length);
    private property <string> mode;
    private property <int> delta;
    function bounded(mode: string, value: int) -> int {
        if mode == "fade-in" { return max(Math.ceil(-root.item.fade_in), value); }
        if mode == "fade-out" { return min(Math.floor(root.item.fade_out), value); }
        if mode == "trim-start" { return clamp(value, Math.ceil(-root.item.start), max(0, Math.ceil(root.item.duration) - 1)); }
        if mode == "trim-end" { return max(value, min(0, 1 - Math.ceil(root.item.duration))); }
        return max(Math.ceil(-root.item.start), value);
    }
    private property <bool> fade_handles: root.item.editable && root.item.selected && root.width >= 56px;
    function fade_x(edge: int) -> length {
        let fade = edge == 0 ? root.item.fade_in : root.item.fade_out;
        return clamp(edge == 0 ? 14px + fade * root.zoom * 1px : root.width - 30px - fade * root.zoom * 1px, 9px, root.width - 25px);
    }
    function body_mode(x: length, y: length) -> string {
        if root.fade_handles && y >= 3px && y < 19px {
            if x >= root.fade_x(0) && x < root.fade_x(0) + 16px { return "fade-in"; }
            if x >= root.fade_x(1) && x < root.fade_x(1) + 16px { return "fade-out"; }
        }
        return "move";
    }
    function begin(mode: string) {
        if root.item.editable {
            root.mode = mode;
            root.capture();
        }
    }
    function update(value: int, x: length, y: length) {
        if root.mode != "" {
            root.autoscroll(x, y);
            root.delta = root.bounded(root.mode, value);
        }
    }
    function finish(value: int) {
        let kind = root.mode;
        let delta = root.bounded(kind, value);
        root.mode = "";
        root.delta = 0;
        if kind != "" && delta != 0 { root.gesture(kind, delta); }
        else { root.cancelled(); root.clicked(); }
    }
    function cancel() {
        root.mode = "";
        root.delta = 0;
        root.cancelled();
    }
    x: 10px + (root.item.start + (root.mode == "move" || root.mode == "trim-start" ? root.delta : 0)) * root.zoom * 1px;
    y: (root.video_lanes + root.item.lane) * 84px + 7px;
    width: max(2px, (root.item.duration + (root.mode == "trim-end" ? root.delta : root.mode == "trim-start" ? -root.delta : 0)) * root.zoom * 1px);
    height: 69px; border-radius: 4px;
    background: root.item.muted ? #42404b : root.item.selected || root.mode != "" ? #67449a : #483365;
    Text { x: 8px; y: 7px; width: max(0px, parent.width - 16px); text: root.item.name; color: #f5edff; font-size: 11px; overflow: elide; }
    if root.item.waveform != "": Rectangle {
        x: 8px; y: 26px; width: max(0px, parent.width - 16px); height: 39px;
        accessible-role: image;
        accessible-label: "Waveform " + root.item.name;
        Path { width: parent.width; height: parent.height; viewbox-width: 128; viewbox-height: 40;
            commands: root.item.waveform; stroke: #d4b9ff; stroke-width: 1px; }
    }
    ClipGestureArea {
        width: parent.width; height: parent.height;
        zoom: root.zoom; scroll_x: root.scroll_x; cancel_token: root.cancel_token;
        accessible-role: button; accessible-label: "Audio clip " + root.item.name;
        accessible-description: root.item.description;
        began => { root.begin(root.body_mode(self.mouse-x, self.mouse-y)); }
        preview(value, x, y) => { root.update(value, x, y); }
        finished(value, x, y) => { root.finish(value); }
        cancelled => { root.cancel(); }
    }
    for edge in (root.item.editable ? 2 : 0): ClipGestureArea {
        x: edge == 0 ? 0px : parent.width - self.width;
        width: min(8px, parent.width / 3); height: parent.height;
        zoom: root.zoom; scroll_x: root.scroll_x; cancel_token: root.cancel_token;
        mouse-cursor: ew-resize;
        accessible-role: button;
        accessible-label: "Trim audio " + (edge == 0 ? "start" : "end") + " of " + root.item.name;
        began => { root.begin(edge == 0 ? "trim-start" : "trim-end"); }
        preview(value, x, y) => { root.update(value, x, y); }
        finished(value, x, y) => { root.finish(value); }
        cancelled => { root.cancel(); }
    }
    for edge in (root.fade_handles ? 2 : 0): Rectangle {
        x: root.fade_x(edge); y: 3px; width: 16px; height: 16px;
        accessible-role: button;
        accessible-label: (edge == 0 ? "Audio fade in " : "Audio fade out ") + root.item.name;
        Rectangle {
            x: 3px + (root.mode == (edge == 0 ? "fade-in" : "fade-out") ? root.delta * root.zoom * 1px : 0px);
            y: 3px; width: 9px; height: 9px; border-radius: 2px;
            background: #d4b9ff; border-width: 1px; border-color: #4b3669;
        }
    }
}

component TimelineClip inherits Rectangle {
    in property <ClipRow> item;
    in property <float> zoom: 16;
    in property <int> cancel_token;
    callback clicked(bool);
    in property <string> edit_mode;
    in property <bool> part_of_group;
    in property <int> group_delta;
    callback group_preview(int);
    private property <bool> additive;
    callback focused();
    callback cancelled();
    callback gesture(string, int, string);
    callback target_lane(length) -> int;
    callback lane_id(int) -> string;
    callback drop_error(string, int) -> string;
    callback snapped_delta(string, int, string) -> int;
    callback clear_snap();
    callback autoscroll(length, length);
    in property <length> scroll_x;
    private property <length> lane_height: 84px;
    private property <int> lane: root.item.lane;
    private property <string> error: "";
    function clear_drag() {
        root.clear_snap();
        if root.part_of_group && root.gesture_kind == "move" { root.group_preview(0); }
        root.gesture_kind = "";
        root.delta = 0;
        root.lane = root.item.lane;
        root.error = "";
    }
    function update_move(value: int, y: length) {
        root.lane = root.part_of_group ? root.item.lane : root.target_lane(y);
        let track = root.lane_id(root.lane);
        root.delta = root.bounded_delta("move", root.snapped_delta("move", value, track));
        if root.part_of_group { root.group_preview(root.delta); }
        root.error = root.part_of_group ? "" : track == "" ? "Drop onto a video track" : root.drop_error(track, root.delta);
    }
    private property <string> gesture_kind: "";
    private property <int> delta: 0;
    function bounded_delta(kind: string, value: int) -> int {
        if kind == "move" { return max(-root.item.start, value); }
        if kind == "trim-start" { return clamp(value, -root.item.start, root.item.duration - 1); }
        return max(1 - root.item.duration, value);
    }
    function finish(kind: string, value: int) {
        let result = root.bounded_delta(kind, value);
        let track = kind == "move" ? root.lane_id(root.lane) : root.item.track;
        let changed = result != 0 || track != root.item.track;
        root.clear_drag();
        if changed { root.gesture(kind, result, track); }
        else { root.cancelled(); root.clicked(root.additive); }
    }
    x: 10px + (root.item.x + (root.gesture_kind == "move" || root.gesture_kind == "slide" || root.gesture_kind == "trim-start" ? root.delta : root.part_of_group ? root.group_delta : 0) * root.zoom) * 1px;
    y: 8px + (root.gesture_kind == "move" && root.lane >= 0 ? root.lane : root.item.lane) * root.lane_height;
    width: max(2px, (root.item.width + (root.gesture_kind == "trim-end" ? root.delta * root.zoom : root.gesture_kind == "trim-start" ? -root.delta * root.zoom : 0)) * 1px);
    height: 72px;
    background: root.item.selected || root.gesture_kind != "" ? #55387a : root.item.online ? #413052 : #633a3b;
    border-color: root.error != "" ? #ff6666 : root.item.selected || root.gesture_kind != "" ? #ad7aff : #7954a8;
    border-width: root.item.selected ? 2px : 1px; border-radius: 5px;
    accessible-role: button;
    accessible-label: root.item.asset_name;
    accessible-description: "Timeline start " + root.item.start + " frames; duration " + root.item.duration + " frames" + (root.error == "" ? "" : "; " + root.error);
    // A rounded clip in FemtoVG allocates an offscreen target for the whole
    // timeline item, which can exceed the GPU texture limit for ordinary media.
    // Keep the rounded shell, but scissor its contents with a square inset.
    Rectangle {
        x: 2px; y: 2px; width: max(0px, parent.width - 4px); height: parent.height - 4px;
        clip: true;
        if root.item.has_thumbnail: Image { x: 5px; y: 21px; width: min(78px, max(0px, parent.width - 10px)); height: 43px; source: root.item.thumbnail; image-fit: cover; opacity: 0.8; }
        Text { x: 7px; y: 3px; width: max(0px, parent.width - 14px); height: 16px; text: root.item.asset_name; color: #faf5ff; font-size: 12px; font-weight: 600; overflow: elide; }
        Text { x: root.item.has_thumbnail ? 88px : 7px; y: 28px; width: max(0px, parent.width - self.x - 7px); height: 32px; text: (root.item.start + (root.gesture_kind == "move" || root.gesture_kind == "slide" || root.gesture_kind == "trim-start" ? root.delta : 0)) + "f\n" + root.item.duration + (root.item.is_subtitle ? "f subtitle" : root.item.is_title ? "f title" : root.item.is_still ? "f still image" : "f source clip"); color: #dfd2f0; font-size: 11px; }
    }
    if root.gesture_kind == "slip" && root.delta != 0: Text {
        x: 9px; y: 48px; width: max(0px, parent.width - 18px); height: 20px;
        color: #e1cbff; font-size: 11px; text: "Source offset " + root.delta + "f"; overflow: elide;
    }
    if root.error != "": Text {
        x: 9px; y: 48px; width: max(0px, parent.width - 18px); height: 20px;
        color: #ffb3b3; font-size: 11px; text: root.error; overflow: elide;
    }
    ClipGestureArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        scroll_x: root.scroll_x;
        zoom: root.zoom; cancel_token: root.cancel_token;
        began => {
            root.focused(); root.additive = self.additive;
            root.gesture_kind = root.edit_mode == "" ? "move" : root.edit_mode;
            root.delta = 0; root.lane = root.item.lane;
        }
        preview(value, x, y) => {
            if !root.item.locked {
                root.autoscroll(x, y);
                if root.gesture_kind == "move" { root.update_move(value, y); }
                else { root.delta = value; }
            }
        }
        finished(value, x, y) => {
            if root.gesture_kind == "slip" || root.gesture_kind == "slide" {
                let kind = root.gesture_kind;
                root.clear_drag();
                if !root.item.locked && value != 0 { root.gesture(kind, value, root.item.track); }
                else { root.cancelled(); root.clicked(root.additive); }
            } else if root.item.locked || (value == 0 && root.target_lane(y) == root.item.lane && root.delta == 0) {
                root.clear_drag(); root.cancelled(); root.clicked(root.additive);
            } else { root.update_move(value, y); root.finish("move", root.delta); }
        }
        cancelled => { if root.gesture_kind != "" { root.clear_drag(); root.cancelled(); } }
    }
    Rectangle { x: 2px; y: 24px; width: 3px; height: 24px; background: #bd9be7; border-radius: 1px; }
    Rectangle { x: parent.width - 5px; y: 24px; width: 3px; height: 24px; background: #bd9be7; border-radius: 1px; }
    ClipGestureArea {
        x: 0px; y: 0px;
        width: min(9px, parent.width / 3); height: parent.height; zoom: root.zoom; cancel_token: root.cancel_token; mouse-cursor: ew-resize;
        accessible-role: button;
        accessible-label: "Trim start of " + root.item.asset_name;
        enabled: !root.item.locked; scroll_x: root.scroll_x;
        began => { root.focused(); root.additive = false; root.gesture_kind = "trim-start"; root.delta = 0; }
        preview(value, x, y) => { root.autoscroll(x, y); root.delta = root.bounded_delta("trim-start", root.snapped_delta("trim-start", value, root.item.track)); }
        finished(value, x, y) => { root.finish("trim-start", value == 0 ? 0 : root.snapped_delta("trim-start", value, root.item.track)); }
        cancelled => { if root.gesture_kind != "" { root.clear_drag(); root.cancelled(); } }
    }
    ClipGestureArea {
        x: parent.width - self.width; width: min(9px, parent.width / 3); height: parent.height; zoom: root.zoom; cancel_token: root.cancel_token; mouse-cursor: ew-resize;
        accessible-role: button;
        accessible-label: "Trim end of " + root.item.asset_name;
        enabled: !root.item.locked; scroll_x: root.scroll_x;
        began => { root.focused(); root.additive = false; root.gesture_kind = "trim-end"; root.delta = 0; }
        preview(value, x, y) => { root.autoscroll(x, y); root.delta = root.bounded_delta("trim-end", root.snapped_delta("trim-end", value, root.item.track)); }
        finished(value, x, y) => { root.finish("trim-end", value == 0 ? 0 : root.snapped_delta("trim-end", value, root.item.track)); }
        cancelled => { if root.gesture_kind != "" { root.clear_drag(); root.cancelled(); } }
    }
}

component TimingField inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> enabled: true;
    callback committed(string);
    spacing: 4px;
    Text { text: root.label; color: #939ba2; font-size: 12px; }
    changed value => { field.text = root.value; }
    field := LineEdit { accessible-label: root.label; enabled: root.enabled; text: root.value; placeholder-text: "Enter value"; accepted(value) => { root.committed(value); } }
}

component TrackButton inherits ToolButton {
    min-width: 18px;
    max-width: 10000px;
    height: 18px;
    icon-size: 14px;
    horizontal-stretch: 1;
}

export component EditorWindow inherits Window {
    no-frame: true;
    resize-border-width: root.maximized ? 0px : 6px;
    in property <bool> window-controls-on-left;
    in property <bool> mac-style-controls;
    title: "OpenQuartz Studio — " + root.project_name;
    icon: root.mac-style-controls ? @image-url("../assets/icon.png") : @image-url("../assets/icon-windows.png");
    preferred-width: 1440px; preferred-height: 900px; min-width: 1040px; min-height: 700px;
    background: #111315; default-font-size: 12px;
    private property <bool> compact-workspace: false;
    changed width => { root.compact-workspace = root.width < 1250px; }
    accessible-role: main;
    accessible-label: "OpenQuartz video editor";
    accessible-description: "Project " + root.project_name + "; assets " + root.assets.length + "; clips " + root.clips.length + "; playhead " + root.selected_frame + " frames, " + root.timecode + "; " + root.project_status + (root.project_dirty ? "; Unsaved changes" : "") + "; " + root.io_status + "; " + root.monitor_status + "; " + root.hdr_monitor_status + (root.export_status == "" ? "" : "; " + root.export_status) + (root.audio_clips.length == 0 ? "" : "; audio clips " + root.audio_clips.length) + (root.audio_level == "" ? "" : "; " + root.audio_level) + (root.recovery_status == "" ? "" : "; " + root.recovery_status) + (root.selection_size > 1 ? "; " + root.selection_size + " selected" : "") + (root.proxy_status == "" ? "" : "; " + root.proxy_status) + (root.clips.length + root.audio_clips.length > 256 ? "; timeline window " + root.timeline_video_clips.length + " video · " + root.timeline_audio_clips.length + " audio" : "");
    forward-focus: editor_focus;
