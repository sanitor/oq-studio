    in-out property <string> draft_fps_numerator;
    in-out property <string> draft_fps_denominator;
    function open_settings() {
        root.draft_width = root.project_data_width + "";
        root.draft_height = root.project_data_height + "";
        root.draft_fps_numerator = root.sequence_fps_numerator;
        root.draft_fps_denominator = root.sequence_fps_denominator;
        root.settings_open = true;
        root.cancel_token += 1;
        root.project_action("settings");
    }
    private property <int> cancel_token: 0;
    private property <int> ruler_step: max(1, Math.ceil(100 / max(0.0001, root.timeline_zoom)));
    function set_zoom(value: float) {
        let anchor = -timeline_scroll.content-x / 1px / max(0.0001, root.timeline_zoom);
        root.cancel_token += 1;
        root.timeline_zoom = clamp(value, 0.0001, 48);
        root.zoom_changed(root.timeline_zoom);
        timeline_scroll.content-x = min(0px, -anchor * root.timeline_zoom * 1px);
    }
    function fit_timeline() {
        root.set_zoom((timeline_scroll.visible-width / 1px - 32) / max(1, root.sequence_duration));
        timeline_scroll.content-x = 0px;
    }
    function ruler_label(frame: int) -> string {
        if root.timeline_zoom >= 4 { return frame + "f"; }
        let seconds = Math.round(frame * root.sequence_fps_denominator.to-float() / max(1, root.sequence_fps_numerator.to-float()));
        if seconds < 60 { return seconds + "s"; }
        let minutes = Math.floor(seconds / 60);
        let remainder = Math.mod(seconds, 60);
        return minutes + ":" + (remainder < 10 ? "0" : "") + remainder;
    }
    function target_lane(y: length) -> int {
        let local = y - timeline_scroll.absolute-position.y;
        if local < 0px || local >= timeline_scroll.visible-height { return -1; }
        let lane = floor((local - timeline_scroll.content-y) / 84px);
        return lane < root.tracks.length ? lane : -1;
    }
    function lane_id(lane: int) -> string {
        return lane >= 0 && lane < root.tracks.length ? root.tracks[lane].id : "";
    }
    function edge_scroll(x: length, y: length, horizontal: bool) {
        let local_y = y - timeline_scroll.absolute-position.y;
        if local_y < 16px {
            timeline_scroll.content-y = min(0px, timeline_scroll.content-y + 8px);
        } else if local_y > timeline_scroll.visible-height - 16px {
            timeline_scroll.content-y = max(timeline_scroll.visible-height - timeline_scroll.content-height, timeline_scroll.content-y - 8px);
        }
        if horizontal {
            let local_x = x - timeline_scroll.absolute-position.x;
            if local_x < 18px {
                timeline_scroll.content-x = min(0px, timeline_scroll.content-x + 10px);
            } else if local_x > timeline_scroll.visible-width - 18px {
                timeline_scroll.content-x = max(timeline_scroll.visible-width - timeline_scroll.content-width, timeline_scroll.content-x - 10px);
            }
        }
    }
    function asset_drop(id: string, x: length, y: length) {
        let lane = root.lane_id(root.target_lane(y));
        let local = x - timeline_scroll.absolute-position.x;
        if lane != "" && local >= 0px && local < timeline_scroll.visible-width {
            let frame = max(0, Math.round(((local - timeline_scroll.content-x) / 1px - 10) / max(0.0001, root.timeline_zoom)));
            root.asset_place(id, lane, frame);
        }
    }
    function grip_x(handle: int) -> length {
        let px = handle == 0 ? root.monitor_box.ax : handle == 1 ? root.monitor_box.bx : handle == 2 ? root.monitor_box.cx : handle == 3 ? root.monitor_box.dx : root.monitor_box.tx;
        let ideal = monitor_surface.origin_x + px * monitor_surface.fit * 1px + (handle == 4 ? sin(root.monitor_box.angle * 1deg) * 20px : 0px);
        return ideal >= -14px && ideal <= monitor_surface.width + 14px ? clamp(ideal, 10px, monitor_surface.width - 10px) : ideal;
    }
    function grip_y(handle: int) -> length {
        let py = handle == 0 ? root.monitor_box.ay : handle == 1 ? root.monitor_box.by : handle == 2 ? root.monitor_box.cy : handle == 3 ? root.monitor_box.dy : root.monitor_box.ty;
        let ideal = monitor_surface.origin_y + py * monitor_surface.fit * 1px - (handle == 4 ? cos(root.monitor_box.angle * 1deg) * 20px : 0px);
        return ideal >= -24px && ideal <= monitor_surface.height + 14px ? clamp(ideal, 10px, monitor_surface.height - 10px) : ideal;
    }
    function monitor_hit(x: length, y: length) -> string {
        if !root.monitor_box.visible || root.monitor_box.locked { return "move"; }
        if abs(x - root.grip_x(0)) <= 10px && abs(y - root.grip_y(0)) <= 10px { return "nw"; }
        if abs(x - root.grip_x(1)) <= 10px && abs(y - root.grip_y(1)) <= 10px { return "ne"; }
        if abs(x - root.grip_x(2)) <= 10px && abs(y - root.grip_y(2)) <= 10px { return "se"; }
        if abs(x - root.grip_x(3)) <= 10px && abs(y - root.grip_y(3)) <= 10px { return "sw"; }
        if abs(x - root.grip_x(4)) <= 10px && abs(y - root.grip_y(4)) <= 10px { return "rotate"; }
        return "move";
    }
    function monitor_pointer(phase: string, handle: string, x: length, y: length) {
        let scale = monitor_surface.fit;
        if scale > 0 {
            root.monitor_gesture(phase, handle,
                (x - monitor_surface.origin_x) / 1px / scale,
                (y - monitor_surface.origin_y) / 1px / scale,
                7 / scale);
        }
    }
    private property <color> panel: #1b1e21;
    private property <color> border: #30363b;
    private property <color> text: #e7eaed;
    private property <color> secondary: #939ba2;
    private property <color> accent: Theme.accent;

    editor_focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.settings_open = false;
                root.file_dialog_open = false;
                root.cancel_token += 1;
                if root.nodes_open { root.pipeline_action("cancel-connection"); }
                root.shortcut("cancel");
                return accept;
            }
            if root.settings_open || root.file_dialog_open { return reject; }
            // Command is represented as control by Slint on macOS.
            if event.modifiers.control && !event.modifiers.alt {
                if root.nodes_open && !event.modifiers.shift {
                    if event.text == "c" || event.text == "C" { if root.pipeline_can_copy { root.pipeline_action("copy"); } return accept; }
                    if event.text == "v" || event.text == "V" { if root.pipeline_can_paste { root.pipeline_action("paste"); } return accept; }
                    if event.text == "a" || event.text == "A" { root.pipeline_action("select-all"); return accept; }
                }
                if event.text == "n" || event.text == "N" { root.shortcut("new"); return accept; }
                if event.text == "o" || event.text == "O" { root.shortcut("open"); return accept; }
                if event.text == "s" || event.text == "S" { root.shortcut(event.modifiers.shift ? "save-as" : "save"); return accept; }
                if event.text == "i" || event.text == "I" { root.shortcut("import"); return accept; }
                if event.text == "r" || event.text == "R" { root.shortcut("relink"); return accept; }
                if event.text == "z" || event.text == "Z" { root.shortcut(event.modifiers.shift ? "redo" : "undo"); return accept; }
                if event.text == "y" || event.text == "Y" { root.shortcut("redo"); return accept; }
                if event.text == "b" || event.text == "B" { root.shortcut("split"); return accept; }
            }
            if !root.nodes_open && event.modifiers.alt && event.modifiers.shift && !event.modifiers.control {
                if event.text == Key.UpArrow { root.shortcut("track-up"); return accept; }
                if event.text == Key.DownArrow { root.shortcut("track-down"); return accept; }
            }
            if !event.modifiers.control && !event.modifiers.alt {
                if root.multicam_open && !root.nodes_open {
                    if event.text == "1" { root.shortcut("camera-0"); return accept; }
                    if event.text == "2" { root.shortcut("camera-1"); return accept; }
                    if event.text == "3" { root.shortcut("camera-2"); return accept; }
                    if event.text == "4" { root.shortcut("camera-3"); return accept; }
                }
                if event.text == " " { root.shortcut("play"); return accept; }
                if event.text == Key.LeftArrow { root.shortcut("step-back"); return accept; }
                if event.text == Key.RightArrow { root.shortcut("step-forward"); return accept; }
                if event.text == Key.Delete || event.text == Key.Backspace {
                    if root.nodes_open { root.pipeline_action(root.pipeline_selected_edge_id != "" ? "delete-edge" : "remove-nodes"); }
                    else { root.shortcut("delete"); }
                    return accept;
                }
            }
            reject
        }
        VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: 56px; background: #181a1c;
                WindowMoveArea {
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 16px;
                        cross-axis-alignment: center;
                        if root.window-controls-on-left: WindowControls {
                            mac-style: root.mac-style-controls; maximized: root.maximized;
                            foreground: root.text; hover-background: #303438;
                            minimize-window => { root.minimized = true; }
                            toggle-maximize-window => { root.maximized = !root.maximized; }
                            close-window => { root.close(); }
                        }
                        Image {
                            width: 28px; height: 28px;
                            source: @image-url("../assets/logo-header.svg");
                            image-fit: contain;
                        }
                        SegmentedControl {
                            width: 160px; horizontal-stretch: 0;
                            options: [
                                { key: "edit", label: "Edit", accessible-name: "Edit workspace", symbol: ActionSymbol.edit },
                                { key: "nodes", label: "Nodes", accessible-name: "Nodes workspace", symbol: ActionSymbol.node }
                            ];
                            selected-key: root.nodes_open ? "nodes" : "edit";
                            selected-description: "Current workspace";
                            selected(key) => {
                                editor_focus.focus();
                                root.nodes_open = key == "nodes";
                                root.library_tab = root.nodes_open ? "nodes" : "media";
                                root.nodes_workspace_changed(root.nodes_open);
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        LineEdit {
                            width: 220px; height: 30px;
                            accessible-label: "Project name";
                            accessible-description: "Rename the current project";
                            text: root.project_name;
                            placeholder-text: "Project name";
                            accepted(value) => { root.rename_project(value); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if !root.window-controls-on-left: WindowControls {
                            mac-style: root.mac-style-controls; maximized: root.maximized;
                            foreground: root.text; hover-background: #303438;
                            minimize-window => { root.minimized = true; }
                            toggle-maximize-window => { root.maximized = !root.maximized; }
                            close-window => { root.close(); }
                        }
                    }
                }
            }
            Rectangle {
                height: 44px; background: #202326;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 16px; spacing: 8px; cross-axis-alignment: center;
                    ToolButton { label: "NEW"; symbol: ActionSymbol.add; tooltip-text: "New project"; clicked => { root.project_action("new"); } }
                    ToolButton { label: "OPEN"; symbol: ActionSymbol.folder; tooltip-text: "Open project"; clicked => { root.project_action("open"); } }
                    ToolButton { label: "SAVE"; symbol: ActionSymbol.save; tooltip-text: "Save project"; active: root.project_dirty || !root.project_has_path; clicked => { root.project_action("save"); } }
                    ToolButton { label: "SAVE AS"; symbol: ActionSymbol.save-as; tooltip-text: "Save project as"; clicked => { root.project_action("save-as"); } }
                    if root.previous_available: ToolButton { label: "Previous version"; symbol: ActionSymbol.history; clicked => { root.project_action("recover-previous"); } }
                    if !root.export_active: ToolButton { label: "EXPORT"; symbol: ActionSymbol.export-file; tooltip-text: "Export sequence"; clicked => { root.project_action("export"); } }
                    if root.export_active: ToolButton { label: "Cancel export"; symbol: ActionSymbol.stop; clicked => { root.project_action("cancel-export"); } }
                    ToolButton { label: "Render queue"; symbol: ActionSymbol.queue; clicked => { root.delivery_queue_open = true; } }
                    ToolButton { label: "RELINK"; symbol: ActionSymbol.link; tooltip-text: "Relink media"; clicked => { root.project_action("relink"); } }
                    ToolButton { label: "IMPORT"; symbol: ActionSymbol.import-file; tooltip-text: "Import media"; clicked => { root.project_action("import"); } }
                    ToolButton { label: "SEQUENCE"; symbol: ActionSymbol.settings; tooltip-text: "Sequence settings"; clicked => { editor_focus.focus(); root.open_settings(); } }
                    Text { text: root.project_path; color: root.secondary; font-size: 11px; overflow: elide; horizontal-stretch: 1; }
                    Text { text: root.monitor_status == "" ? root.io_status : (root.io_status == "" ? root.monitor_status : root.io_status + " · " + root.monitor_status); color: root.secondary; font-size: 11px; overflow: elide; max-width: 420px; }
                    Rectangle { width: 1px; height: 20px; background: root.border; }
                    ToolButton { label: "UNDO"; symbol: ActionSymbol.undo; tooltip-text: "Undo"; active: root.can_undo; clicked => { editor_focus.focus(); root.undo(); } }
                    ToolButton { label: "REDO"; symbol: ActionSymbol.redo; tooltip-text: "Redo"; active: root.can_redo; clicked => { editor_focus.focus(); root.redo(); } }
                    ToolButton { label: "Recover autosave"; symbol: ActionSymbol.restore; active: root.recovery_available; clicked => { root.project_action("recover-autosave"); } }
                    ToolButton { label: "Discard autosave"; symbol: ActionSymbol.delete; active: root.recovery_available; clicked => { root.project_action("discard-autosave"); } }
                }
            }
            HorizontalLayout {
                spacing: 1px; vertical-stretch: 1;
                Rectangle {
                    width: 250px; background: root.panel;
                    VerticalLayout {
                        spacing: 0px;
                        HorizontalLayout {
                            height: 42px; padding-left: 8px; padding-right: 8px; cross-axis-alignment: center;
                            SegmentedControl {
                                options: [
                                    { key: "media", label: "Media", accessible-name: "Media library tab", symbol: ActionSymbol.film },
                                    { key: "nodes", label: "Nodes", accessible-name: "Node catalog tab", symbol: ActionSymbol.node, disabled: !root.nodes_open }
                                ];
                                selected-key: root.library_tab;
                                selected(key) => { root.library_tab = key; }
                            }
                        }
                        if root.library_tab == "media": VerticalLayout {
                            spacing: 0px;
                            HorizontalLayout {
                                height: 38px; padding-left: 12px; padding-right: 8px; spacing: 2px; cross-axis-alignment: center;
                                LineEdit {
                                    accessible-label: "Search media";
                                    text <=> root.search_query;
                                    placeholder-text: "Search media";
                                    min-width: 0px;
                                    horizontal-stretch: 1;
                                    edited(value) => { root.search_changed(value); }
                                }
                                ToolButton {
                                    label: "Transcribe selected media"; symbol: ActionSymbol.mic;
                                    active: root.has_selected_asset;
                                    clicked => { root.project_action("transcribe"); }
                                }
                                if root.proxy_can_prepare_batch: ToolButton { label: "Prepare all proxies"; symbol: ActionSymbol.proxy; active: !root.proxy_building; clicked => { root.project_action("prepare-proxy-batch"); } }
                                if root.has_offline_assets: ToolButton { label: "Relink folder"; symbol: ActionSymbol.folder; clicked => { root.project_action("relink-folder"); } }
                                ToolButton { label: "Import files"; symbol: ActionSymbol.track-add; clicked => { root.project_action("import-files"); } }
                                ToolButton { label: "IMPORT"; symbol: ActionSymbol.import-file; tooltip-text: "Import media"; clicked => { root.project_action("import"); } }
                            }
                            if root.proxy_can_prepare || root.proxy_building || root.proxy_mode: VerticalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 4px;
                                HorizontalLayout {
                                    spacing: 4px;
                                    ToolButton { label: root.proxy_building ? "Cancel proxy" : "Prepare proxy"; symbol: root.proxy_building ? ActionSymbol.stop : ActionSymbol.proxy; active: root.proxy_building || root.proxy_can_prepare; clicked => { root.project_action(root.proxy_building ? "cancel-proxy" : "prepare-proxy"); } }
                                    ToolButton { label: root.proxy_mode ? "Use originals" : "Use proxies"; symbol: ActionSymbol.layers; selected: root.proxy_mode; clicked => { root.project_action("toggle-proxies"); } }
                                }
                                if root.proxy_status != "": Text { text: root.proxy_status; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                            }
                            HorizontalLayout { height: 30px; padding-left: 14px; padding-right: 12px; Text { text: "Project media"; color: root.text; font-size: 12px; font-weight: 600; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Text { text: root.assets.length + " items"; color: root.secondary; font-size: 11px; vertical-alignment: center; } }
                            ScrollView {
                                horizontal-stretch: 1; vertical-stretch: 1;
                                VerticalLayout {
                                    padding: 10px; spacing: 8px;
                                    if root.assets.length == 0: Rectangle { height: 160px; background: #151719; border-radius: 8px; VerticalLayout { alignment: LayoutAlignment.center; padding: 12px; spacing: 8px; Text { text: root.search_query == "" ? "Your media library" : "No matching media"; color: root.text; font-size: 12px; font-weight: 650; horizontal-alignment: center; } Text { text: root.search_query == "" ? "Import video, audio, PNG or JPEG" : "Try another search"; color: root.secondary; font-size: 11px; horizontal-alignment: center; } ToolButton { label: "Import media"; symbol: ActionSymbol.import-file; show-label: true; primary: true; clicked => { root.project_action("import"); } } } }
                                    for asset in root.assets: AssetCard { asset: asset; clicked => { editor_focus.focus(); root.asset_select(asset.id); } dropped(id, x, y) => { root.asset_drop(id, x, y); }
                                    add_clicked(id) => { editor_focus.focus(); root.add_asset_to_timeline(id); } }
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                            Rectangle {
                                height: 80px; background: #151719;
                                VerticalLayout {
                                    padding: root.camera_log_available ? 8px : 12px;
                                    spacing: root.camera_log_available ? 3px : 5px;
                                    Text { text: root.selected_asset_name; color: root.text; font-size: 12px; font-weight: 600; overflow: elide; }
                                    Text {
                                        text: root.selected_asset_details; color: root.secondary; font-size: 11px;
                                        wrap: root.camera_log_available ? no-wrap : word-wrap;
                                        overflow: elide;
                                    }
                                    if root.camera_log_available: ComboBox {
                                        accessible-label: "Input color"; current-index <=> root.camera_log_index;
                                        model: ["Auto (metadata)", "Sony S-Log3 / S-Gamut3.Cine", "Sony S-Log3 / S-Gamut3", "Sony S-Log2 / S-Gamut"];
                                        selected => { root.camera_log_changed(self.current-index); }
                                    }
                                }
                            }

                        }
                        if root.library_tab == "nodes": VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            vertical-stretch: 1;
                            LineEdit {
                                accessible-label: "Search nodes";
                                placeholder-text: "Search nodes";
                                text <=> root.node_search;
                                edited(value) => { root.node_search_changed(value); }
                            }
                            Text { text: "Add after selected node"; color: root.secondary; font-size: 11px; }
                            ToolButton {
                                label: "Import CUBE LUT"; symbol: ActionSymbol.cube; show-label: true; active: root.nodes_open && root.selected_clip_id != "" && !root.pipeline_busy && !root.pipeline_inspector_dirty;
                                clicked => { root.project_action("lut"); }
                            }
                            effects-scroll := ScrollView {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    padding-bottom: 8px;
                                    spacing: 10px;
                                    if root.pipeline_effect_groups.length == 0: Text {
                                        text: "No matching nodes";
                                        color: root.secondary;
                                        font-size: 11px;
                                    }
                                    for group in root.pipeline_effect_groups: VerticalLayout {
                                        spacing: 5px;
                                        Text { text: group.label; color: root.text; font-size: 10px; font-weight: 700; }
                                        Rectangle {
                                            height: Math.ceil(group.effects.length / 3) * 75px - 6px;
                                            for effect[index] in group.effects: NodeEffectTile {
                                                x: Math.mod(index, 3) * 75px;
                                                y: Math.floor(index / 3) * 75px;
                                                effect: effect;
                                                enabled: root.nodes_open && root.selected_clip_id != "" && !root.pipeline_busy && !root.pipeline_inspector_dirty;
                                                clicked => { editor_focus.focus(); root.pipeline_add_effect(effect.index); }
                                            }
                                        }
                                    }
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1; background: #101213;
                    VerticalLayout {
                        spacing: 0px;
                        HorizontalLayout { height: 44px; padding-left: 14px; padding-right: 14px; spacing: 6px; cross-axis-alignment: center; Text { text: root.nodes_open ? (root.pipeline_monitor_label == "" ? "Final · " + root.selected_clip_name : "Node · " + root.pipeline_monitor_label) : "Preview"; color: root.text; font-size: 12px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; } if !root.nodes_open: ToolButton { label: "TRANSFORM"; symbol: ActionSymbol.transform; tooltip-text: "Transform clip"; selected: root.show_transform; clicked => { editor_focus.focus(); root.show_transform = !root.show_transform; root.monitor_gesture("cancel", "", 0, 0, 0); } }
                            if root.nodes_open: ToolButton {
                                label: root.pipeline_monitor_label == "" ? "View selected node" : "View final output"; symbol: root.pipeline_monitor_label == "" ? ActionSymbol.node : ActionSymbol.monitor;
                                active: root.pipeline_monitor_label != "" || root.pipeline_selection_count == 1;
                                clicked => { root.pipeline_action(root.pipeline_monitor_label == "" ? "show-selected-node" : "show-program"); }
                            }
                            if root.nodes_open: ToolButton {
                                label: "Grade versions"; symbol: ActionSymbol.layers; active: root.grade_available;
                                clicked => { root.grades_open = true; }
                            }
                            ComboBox {
                                width: root.compact-workspace ? 118px : 146px; accessible-label: "Color scope";
                                model: ["Scopes off", "RGB histogram", "Luma waveform", "RGB parade", "Vectorscope"];
                                current-index <=> root.color_scope_mode;
                                selected => { root.color_scope_changed(self.current-index); }
                            }
                            Text { text: root.project_data_width + " × " + root.project_data_height; color: root.secondary; font-size: 11px; vertical-alignment: center; } }
                        if root.nodes_open: HorizontalLayout {
                            height: 34px; padding-left: 14px; padding-right: 14px; spacing: 6px; cross-axis-alignment: center;
                            ToolButton {
                                label: root.pipeline_compare_active ? "Close comparison" : "Compare original"; symbol: ActionSymbol.compare; selected: root.pipeline_compare_active;
                                active: root.selected_clip_id != "";
                                clicked => { root.pipeline_action("compare-original"); }
                            }
                            if root.pipeline_can_bypass: ToolButton {
                                label: root.pipeline_node_bypassed ? "Enable node" : "Bypass node"; symbol: root.pipeline_node_bypassed ? ActionSymbol.eye : ActionSymbol.eye-off; selected: root.pipeline_node_bypassed;
                                active: !root.pipeline_busy && !root.pipeline_inspector_dirty;
                                clicked => { root.pipeline_action("bypass-selected-node"); }
                            }
                            if root.pipeline_compare_active: Text { text: "Original"; color: root.secondary; vertical-alignment: center; }
                            if root.pipeline_compare_active: Slider {
                                accessible-label: "Original comparison split";
                                minimum: 0; maximum: 1; step: 0.01;
                                value <=> root.pipeline_split;
                                changed(value) => { root.pipeline_compare_split(value); }
                            }
                            if root.pipeline_compare_active: Text { text: "Graded"; color: root.secondary; vertical-alignment: center; }
                        }
                        if root.nodes_open: HorizontalLayout {
                            height: 34px; padding-left: 14px; padding-right: 14px; spacing: 6px; cross-axis-alignment: center;
                            ToolButton {
                                label: "Grab still"; symbol: ActionSymbol.camera; active: root.has_monitor_image && !root.playing && !root.reference_capture_busy && !root.reference_viewing && root.reference_names.length < 8;
                                clicked => { root.reference_action("grab", root.reference_index); }
                            }
                            if root.reference_names.length > 0: ComboBox {
                                accessible-label: "Reference still"; model: root.reference_names;
                                current-index <=> root.reference_index;
                                selected => { root.reference_action("select", self.current-index); }
                            }
                            if root.reference_names.length > 0: ToolButton {
                                label: root.reference_viewing ? "Show live" : "Show still"; symbol: root.reference_viewing ? ActionSymbol.monitor : ActionSymbol.image; selected: root.reference_viewing;
                                clicked => { root.reference_action("view", root.reference_index); }
                            }
                            if root.reference_names.length > 0: ToolButton {
                                label: "Remove still"; symbol: ActionSymbol.delete; clicked => { root.reference_action("remove", root.reference_index); }
                            }
                            if root.reference_names.length > 0: ToolButton {
                                label: "Match shot"; symbol: ActionSymbol.match; active: root.selected_clip_writable && !root.reference_viewing && !root.playing;
                                clicked => { root.reference_action("match", root.reference_index); }
                            }
                        }
                        monitor_surface := Rectangle {
                            horizontal-stretch: 1; vertical-stretch: 1; background: #0a0b0c;
                            clip: true;
                            property <float> fit: min(self.width / 1px / root.project_data_width, self.height / 1px / root.project_data_height);
                            property <length> origin_x: (self.width - root.project_data_width * self.fit * 1px) / 2;
                            property <length> origin_y: (self.height - root.project_data_height * self.fit * 1px) / 2;
                            accessible-role: image;
                            accessible-label: "Video preview";
                            if root.has_monitor_image: Image { width: parent.width; height: parent.height; source: root.monitor_image; image-fit: contain; }
                            if root.nodes_open && root.reference_viewing: Image {
                                width: parent.width; height: parent.height; source: root.reference_image; image-fit: contain;
                                accessible-role: image; accessible-label: "Reference still preview";
                            }
                            if root.color_scope_mode != 0 && !root.reference_viewing: Rectangle {
                                width: min(272px, parent.width - 20px); height: 144px;
                                x: parent.width - self.width - 10px; y: 10px;
                                background: #14191cec; border-color: root.border; border-width: 1px; border-radius: 5px;
                                VerticalLayout {
                                    padding: 7px; spacing: 4px;
                                    Image {
                                        source: root.color_scope_plot; image-fit: contain;
                                        accessible-role: image; accessible-label: "Color scope plot";
                                        accessible-description: root.color_scope_summary;
                                    }
                                    Text { text: root.color_scope_summary; color: root.text; font-size: 10px; }
                                }
                            }

                            if !root.has_monitor_image: VerticalLayout { alignment: LayoutAlignment.center; cross-axis-alignment: center; spacing: 8px; ActionIcon { symbol: ActionSymbol.film; width: 36px; height: 36px; stroke: #444b50; } Text { text: "Add media to the timeline"; color: #7c848a; font-size: 12px; horizontal-alignment: center; } }
                            if !root.nodes_open && root.show_transform && root.monitor_box.visible: Path {
                                width: parent.width; height: parent.height;
                                stroke: root.monitor_box.locked ? #a8aeb4 : root.accent;
                                stroke-width: 1.5px;
                                MoveTo { x: monitor_surface.origin_x / 1px + root.monitor_box.ax * monitor_surface.fit; y: monitor_surface.origin_y / 1px + root.monitor_box.ay * monitor_surface.fit; }
                                LineTo { x: monitor_surface.origin_x / 1px + root.monitor_box.bx * monitor_surface.fit; y: monitor_surface.origin_y / 1px + root.monitor_box.by * monitor_surface.fit; }
                                LineTo { x: monitor_surface.origin_x / 1px + root.monitor_box.cx * monitor_surface.fit; y: monitor_surface.origin_y / 1px + root.monitor_box.cy * monitor_surface.fit; }
                                LineTo { x: monitor_surface.origin_x / 1px + root.monitor_box.dx * monitor_surface.fit; y: monitor_surface.origin_y / 1px + root.monitor_box.dy * monitor_surface.fit; }
                                Close {}
                            }
                            for handle in (!root.nodes_open && root.show_transform && root.monitor_box.visible && !root.monitor_box.locked ? 5 : 0): Rectangle {
                                x: root.grip_x(handle) - 10px;
                                y: root.grip_y(handle) - 10px;
                                width: 20px; height: 20px;
                                accessible-role: button;
                                accessible-label: handle == 4 ? "Rotate clip" : handle == 0 ? "Resize top left" : handle == 1 ? "Resize top right" : handle == 2 ? "Resize bottom right" : "Resize bottom left";
                                Rectangle { x: 6px; y: 6px; width: 8px; height: 8px; border-radius: handle == 4 ? 4px : 1px; background: root.accent; border-width: 1px; border-color: #281c3a; }
                            }
                            // Capture on the stationary viewport. The grips themselves
                            // move while the same pointer capture is active.
                            if !root.nodes_open && root.has_monitor_image: TouchArea {
                                property <bool> armed: false;
                                property <string> handle: "move";
                                property <string> hover: root.show_transform ? root.monitor_hit(self.mouse-x, self.mouse-y) : "move";
                                property <int> cancel_token: root.cancel_token;
                                mouse-cursor: self.hover == "rotate" ? crosshair : self.hover == "nw" || self.hover == "se" ? nwse-resize : self.hover == "ne" || self.hover == "sw" ? nesw-resize : default;
                                changed cancel_token => { self.armed = false; }
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.cancel && self.armed {
                                        self.armed = false;
                                        root.monitor_pointer("cancel", self.handle, self.mouse-x, self.mouse-y);
                                    }
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                        editor_focus.focus();
                                        self.armed = true;
                                        self.handle = self.hover;
                                        if root.show_transform { root.monitor_pointer("start", self.handle, self.mouse-x, self.mouse-y); }
                                    }
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && self.armed {
                                        self.armed = false;
                                        root.monitor_pointer(root.show_transform ? "finish" : "pick", self.handle, self.mouse-x, self.mouse-y);
                                    }
                                }
                                moved => {
                                    if self.armed && root.show_transform { root.monitor_pointer("move", self.handle, self.mouse-x, self.mouse-y); }
                                }
                            }
                        }
                        if root.source_visible: VerticalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 4px;
                            HorizontalLayout {
                                spacing: 4px;
                                ToolButton { label: "Previous source frame"; symbol: ActionSymbol.previous; active: root.source_can_previous; clicked => { root.source_action("previous", ""); } }
                                LineEdit {
                                    in property <string> cursor_text: root.source_frame;
                                    width: 63px; text: self.cursor_text; accessible-label: "Source monitor frame";
                                    changed cursor_text => { self.text = self.cursor_text; }
                                    accepted(value) => { root.source_action("seek", value); }
                                }
                                ToolButton { label: "Next source frame"; symbol: ActionSymbol.next; active: root.source_can_next; clicked => { root.source_action("next", ""); } }
                                ToolButton { label: "Mark In"; symbol: ActionSymbol.mark-in; clicked => { root.source_action("in", ""); } }
                                ToolButton { label: "Mark Out"; symbol: ActionSymbol.mark-out; clicked => { root.source_action("out", ""); } }
                                ToolButton { label: "Clear marks"; symbol: ActionSymbol.close; active: root.source_marks_set; clicked => { root.source_action("clear", ""); } }
                                ToolButton { label: "Set camera sync point"; symbol: ActionSymbol.target; clicked => { root.project_action("register-camera"); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                Text { text: root.source_range; color: root.secondary; font-size: 12px; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                if root.source_has_audio: ComboBox {
                                    width: 142px; accessible-label: "Source audio destination";
                                    model: root.source_audio_tracks;
                                    current-index <=> root.source_audio_index;
                                    selected => { root.source_audio_changed(self.current-index); }
                                }
                            }
                        }
                        if root.multicam_open && !root.source_visible && root.camera_angles.length > 1: HorizontalLayout {
                            padding: 4px; spacing: 4px;
                            for angle[index] in root.camera_angles: VerticalLayout {
                                ToolButton { label: "Cut to " + angle; symbol: ActionSymbol.split; show-label: true; clicked => { editor_focus.focus(); root.camera_chosen(index, true); } }
                                ToolButton { label: "Replace with " + angle; symbol: ActionSymbol.overwrite; show-label: true; clicked => { editor_focus.focus(); root.camera_chosen(index, false); } }
                            }
                            ToolButton { label: "Close angles"; symbol: ActionSymbol.close; clicked => { editor_focus.focus(); root.project_action("camera-monitor"); } }
                        }
                        Text { text: root.playback_summary; accessible-role: AccessibleRole.text; accessible-label: root.playback_metrics; height: 18px; color: root.secondary; font-size: 10px; overflow: elide; }
                        transport := Rectangle {
                            height: 52px; background: #191c1e;
                            min-width: 0px; preferred-width: 0px; max-width: 10000px;
                            private property <bool> show-duration: true;
                            changed width => { self.show-duration = self.width >= 350px; }
                            HorizontalLayout {
                                width: parent.width; height: parent.height;
                                padding-left: 8px; padding-right: 12px;
                                spacing: 6px; cross-axis-alignment: center;
                                Rectangle { horizontal-stretch: 1; }
                                ToolButton { label: "PREVIOUS"; symbol: ActionSymbol.previous; tooltip-text: "Previous frame"; clicked => { editor_focus.focus(); root.step_frame(-1); } }
                                ToolButton { label: root.playing ? "PAUSE" : "PLAY"; symbol: root.playing ? ActionSymbol.pause : ActionSymbol.play; tooltip-text: root.playing ? "Pause" : "Play"; selected: root.playing; clicked => { editor_focus.focus(); root.playback(root.playing ? "pause" : "play"); } }
                                ToolButton { label: "NEXT"; symbol: ActionSymbol.next; tooltip-text: "Next frame"; clicked => { editor_focus.focus(); root.step_frame(1); } }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: root.timecode; accessible-label: "Current timecode"; color: Theme.accent-text; font-size: 12px; vertical-alignment: center; }
                                if transport.show-duration: Text { text: "/ " + root.sequence_timecode; accessible-label: "Sequence timecode"; color: root.secondary; font-size: 11px; vertical-alignment: center; }
                            }
                        }
                    }
                }
                if root.nodes_open: Rectangle {
                    horizontal-stretch: 1; min-width: root.compact-workspace ? 224px : 420px; background: root.panel;
                    VerticalLayout {
                        spacing: 0px;
                        HorizontalLayout {
                            height: 36px; padding-left: 14px; padding-right: 14px; spacing: 10px;
                            Text { text: "Clip pipeline"; color: root.text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                            Text { text: root.selected_clip_id == "" ? "Select a timeline clip" : root.selected_clip_name; color: root.secondary; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                        }
                        if root.pipeline_tab_clips.length > 0: clip-tabs-view := ScrollView {
                            height: min(116px, clip-tabs.height + 6px);
                            horizontal-scrollbar-policy: always-off;
                            content-width: self.visible-width;
                            content-height: clip-tabs.height + 6px;
                            clip-tabs := SegmentedControl {
                                x: 10px; width: max(34px, clip-tabs-view.width - 24px);
                                option-count: root.pipeline_tab_clips.length;
                                selected-key: root.selected_clip_id;
                                dynamic-option(index) => {
                                    let clip = root.pipeline_tab_clips[index];
                                    return {
                                        key: clip.id, label: clip.asset_name, accessible-name: "Pipeline for " + clip.asset_name,
                                        symbol: ActionSymbol.film, thumbnail: clip.thumbnail, has-thumbnail: clip.has_thumbnail,
                                        tint: clip.online ? transparent : #ffaaaa,
                                    };
                                }
                                selected(key) => { editor_focus.focus(); root.clip_select(key); }
                            }
                        }
                        GraphView {
                            horizontal-stretch: 1; vertical-stretch: 1;
                            nodes: root.pipeline_nodes; edges: root.pipeline_edges;
                            content-width: root.pipeline_content_width; content-height: root.pipeline_content_height;
                            origin-x: root.pipeline_origin_x; origin-y: root.pipeline_origin_y;
                            busy: root.pipeline_busy || root.selected_clip_id == "";
                            node-previews-enabled: false;
                            selected-edge-id: root.pipeline_selected_edge_id;
                            pending-node-id: root.pipeline_pending_node_id;
                            pending-port-id: root.pipeline_pending_port_id;
                            connection-active: root.pipeline_connection_active;
                            can-undo: root.can_undo; can-redo: root.can_redo;
                            can-copy: root.pipeline_can_copy; can-paste: root.pipeline_can_paste;
                            selection-count: root.pipeline_selection_count;
                            node-selected(id, additive) => { root.pipeline_node_selected(id, additive); }
                            node-moved(id, x, y) => { root.pipeline_node_moved(id, x, y); }
                            port-selected(node, port, output) => { root.pipeline_port_selected(node, port, output); }
                            port-dropped(node, port, output, x, y, scale) => { root.pipeline_port_dropped(node, port, output, x, y, scale); }
                            edge-selected(id) => { root.pipeline_edge_selected(id); }
                            reconnect-edge => { root.pipeline_action("reconnect-edge"); }
                            delete-edge => { root.pipeline_action("delete-edge"); }
                            cancel-connection => { root.pipeline_action("cancel-connection"); }
                            undo => { root.undo(); } redo => { root.redo(); }
                            copy => { root.pipeline_action("copy"); }
                            paste => { root.pipeline_action("paste"); }
                            select-all => { root.pipeline_action("select-all"); }
                            remove-nodes => { root.pipeline_action("remove-nodes"); }
                            toggle-preview(id) => { root.pipeline_action("toggle-preview:" + id); }
                        }
                        if root.pipeline_error != "": Rectangle {
                            height: 44px; background: #43272b;
                            Text { x: 12px; width: parent.width - 24px; height: parent.height; text: root.pipeline_error; accessible-label: "Pipeline error"; color: #ffaaaa; font-size: 11px; wrap: word-wrap; overflow: elide; vertical-alignment: center; }
                        }
                    }
                }
                Rectangle {
                    width: root.compact-workspace ? 244px : 280px; background: root.panel;
                    VerticalLayout {
                        spacing: 0px;
                        if root.nodes_open: VerticalLayout {
                            spacing: 0px;
                            HorizontalLayout { height: 44px; padding-left: 14px; Text { text: "Node inspector"; color: root.text; font-size: 12px; font-weight: 600; vertical-alignment: center; } }
                            Inspector {
                                horizontal-stretch: 1; vertical-stretch: 1;
                                node-id: root.pipeline_node_id; has-selection: root.pipeline_has_selection; node-type: root.pipeline_node_type; selection-message: root.pipeline_selection_message;
                                project-busy: root.pipeline_busy; is-shader: root.pipeline_is_shader; supports-output-size: root.pipeline_supports_output_size;
                                is-corrector: root.pipeline_is_corrector; corrector-target: root.pipeline_corrector_target;
                                corrector-fields: root.pipeline_corrector_fields; corrector-stages: root.pipeline_corrector_stages;
                                corrector-enabled: root.pipeline_corrector_enabled; corrector-error: root.pipeline_corrector_error;
                                corrector-domain: root.pipeline_corrector_domain;
                                corrector-event(target, action, key, value) => { root.pipeline_corrector_event(target, action, key, value); }
                                label-dirty: root.pipeline_label_dirty; shader-dirty: root.pipeline_shader_dirty; output-size-dirty: root.pipeline_output_size_dirty;
                                uniform-dirty: root.pipeline_uniform_dirty; inspector-dirty: root.pipeline_inspector_dirty; validation-message: root.pipeline_validation_message;
                                uniforms-valid: root.pipeline_uniforms_valid; ports: root.pipeline_ports; uniforms: root.pipeline_uniforms; forms: root.pipeline_forms;
                                node-label <=> root.pipeline_node_label; shader-code <=> root.pipeline_shader_code;
                                label-read-only: root.pipeline_label_read_only; shader-read-only: root.pipeline_shader_read_only; can-delete: root.pipeline_can_delete;
                                auto-size <=> root.pipeline_auto_size; output-width <=> root.pipeline_output_width; output-height <=> root.pipeline_output_height;
                                label-draft-changed(value) => { root.pipeline_label_draft_changed(value); }
                                shader-draft-changed(value) => { root.pipeline_shader_draft_changed(value); }
                                output-size-draft-changed(w, h, auto) => { root.pipeline_output_size_draft_changed(w, h, auto); }
                                uniform-draft-changed(name, value) => { root.pipeline_uniform_draft_changed(name, value); }
                                form-draft-changed(key, value) => { root.pipeline_form_draft_changed(key, value); }
                                apply-form(key) => { root.pipeline_apply_form(key); }
                                apply-label => { root.pipeline_action("apply-label"); }
                                apply-shader => { root.pipeline_action("apply-shader"); }
                                apply-output-size => { root.pipeline_action("apply-output-size"); }
                                apply-uniforms => { root.pipeline_action("apply-uniforms"); }
                                discard-drafts => { root.pipeline_action("discard-drafts"); }
                                delete-node => { root.pipeline_action("remove-nodes"); }
                            }
                            if root.pipeline_error != "": Text { text: root.pipeline_error; color: #ffaaaa; font-size: 11px; wrap: word-wrap; }
                        }
                        if !root.nodes_open: VerticalLayout {
                            HorizontalLayout { height: 44px; padding-left: 16px; Text { text: "Clip properties"; color: root.text; font-size: 12px; font-weight: 600; vertical-alignment: center; } }
                            if root.audio_clip_id != "": audio_properties := ScrollView { horizontal-stretch: 1; vertical-stretch: 1; VerticalLayout { padding: 14px; spacing: 12px;
                                Text { text: root.audio_clip_name; color: root.text; wrap: word-wrap; }
                                if root.audio_clip_speed != "100": Text { text: root.audio_clip_speed + "% speed"; color: root.secondary; font-size: 11px; }
                                Text { text: "Audio timing uses 48 kHz samples. End is exclusive."; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                                TimingField { label: "Audio start"; value: root.audio_clip_start; enabled: !root.audio_clip_linked && !root.audio_clip_locked; committed(value) => { root.audio_clip_action(root.audio_clip_id, "start", value); } }
                                TimingField { label: "Audio end"; value: root.audio_clip_end; enabled: !root.audio_clip_linked && !root.audio_clip_locked; committed(value) => { root.audio_clip_action(root.audio_clip_id, "end", value); } }
                                TimingField { label: "Audio source in"; value: root.audio_clip_source; enabled: !root.audio_clip_linked && !root.audio_clip_locked; committed(value) => { root.audio_clip_action(root.audio_clip_id, "source", value); } }
                                TimingField { label: "Audio clip gain (%)"; value: root.audio_clip_gain; enabled: !root.audio_clip_locked; committed(value) => { root.audio_clip_action(root.audio_clip_id, "gain", value); } }
                                if !root.audio_clip_linked: TimingField { label: "Audio fade in (samples)"; value: root.audio_fade_in; enabled: !root.audio_clip_locked; committed(value) => { root.audio_clip_action(root.audio_clip_id, "fade-in", value); } }
                                if !root.audio_clip_linked: TimingField { label: "Audio fade out (samples)"; value: root.audio_fade_out; enabled: !root.audio_clip_locked; committed(value) => { root.audio_clip_action(root.audio_clip_id, "fade-out", value); } }
                                if root.audio_clip_linked: ToolButton { label: "Unlink audio"; symbol: ActionSymbol.unlink; show-label: true; active: !root.audio_clip_locked; clicked => { root.audio_clip_action(root.audio_clip_id, "unlink", ""); } }
                                if !root.audio_clip_linked: ToolButton { label: "Delete audio clip"; symbol: ActionSymbol.delete; show-label: true; active: !root.audio_clip_locked; clicked => { root.audio_clip_action(root.audio_clip_id, "delete", ""); } }
                                TimingField {
                                    label: "Audio crossfade (samples)"; value: root.audio_crossfade_length;
                                    enabled: !root.audio_clip_locked;
                                    committed(value) => { root.audio_clip_action(root.audio_clip_id, "crossfade", value); }
                                }
                                Rectangle { vertical-stretch: 1; }
                            } }
                            if root.audio_clip_id == "": clip_properties := ScrollView { horizontal-stretch: 1; vertical-stretch: 1; VerticalLayout { padding: 14px; spacing: 12px;
                                Text { text: root.selected_clip_name; color: root.text; font-size: 12px; font-weight: 600; wrap: word-wrap; }
                                Text { text: root.selected_clip_uses_sequence_timing ? "Timeline values are frames. The end is exclusive." : "Timeline values are frames; source values are original stream ticks. End/out are exclusive."; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                                TimingField { label: "Timeline start"; value: root.selected_clip_start; enabled: root.selected_clip_writable; committed(value) => { root.clip_timing_changed("start", value); } }
                                TimingField { label: "Timeline end"; value: root.selected_clip_end; enabled: root.selected_clip_writable; committed(value) => { root.clip_timing_changed("end", value); } }
                                if root.selected_clip_is_title && !root.selected_clip_is_subtitle: TimingField { label: "Title text"; value: root.selected_title_text; enabled: root.selected_clip_writable; committed(value) => { root.clip_timing_changed("title-text", value); } }
                                if root.selected_clip_is_title && !root.selected_clip_is_subtitle: TimingField { label: "Title size (%)"; value: root.selected_title_size; enabled: root.selected_clip_writable; committed(value) => { root.clip_timing_changed("title-size", value); } }
                                if root.selected_clip_is_subtitle: VerticalLayout {
                                    in property <string> cue_id: root.selected_clip_id;
                                    in property <string> cue_text: root.selected_title_text;
                                    spacing: 4px;
                                    changed cue_id => { subtitle_text.text = self.cue_text; }
                                    changed cue_text => { subtitle_text.text = self.cue_text; }
                                    Text { text: "Subtitle text"; color: root.secondary; font-size: 12px; }
                                    subtitle_text := TextEdit {
                                        text: root.selected_title_text;
                                        accessible-label: "Subtitle text";
                                        height: 72px; wrap: word-wrap;
                                        enabled: root.selected_clip_writable;
                                    }
                                    ToolButton {
                                        label: "Apply subtitle text"; symbol: ActionSymbol.check; show-label: true;
                                        active: root.selected_clip_writable && subtitle_text.text != root.selected_title_text;
                                        clicked => { root.clip_timing_changed("subtitle-text", subtitle_text.text); }
                                    }
                                }
                                if !root.selected_clip_uses_sequence_timing: TimingField { label: "Source in"; value: root.selected_clip_source_in; enabled: root.selected_clip_writable; committed(value) => { root.clip_timing_changed("source_in", value); } }
                                if !root.selected_clip_uses_sequence_timing: TimingField { label: "Source out"; value: root.selected_clip_source_out; enabled: root.selected_clip_writable; committed(value) => { root.clip_timing_changed("source_out", value); } }
                                if root.selected_clip_id != "" && !root.selected_clip_uses_sequence_timing: TimingField { label: "Speed (%)"; value: root.selected_clip_speed; enabled: root.selected_clip_writable; committed(value) => { root.clip_timing_changed("speed", value); } }
                                if root.can_roll_end: TimingField { label: "Roll cut (frame)"; value: root.selected_clip_end; committed(value) => { root.clip_timing_changed("roll", value); } }
                                if root.can_dissolve_end: TimingField { label: "Dissolve (frames)"; value: root.selected_dissolve_duration; committed(value) => { root.clip_timing_changed("dissolve", value); } }
                                Text { text: "Duration  " + root.selected_clip_duration + " frames"; color: root.secondary; font-size: 12px; }
                                if root.selected_clip_id != "": VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        height: 28px;
                                        Text { text: "Transform"; color: root.text; vertical-alignment: center; }
                                        ToolButton { label: "Reset"; symbol: ActionSymbol.history; show-label: true; active: root.selected_clip_writable; clicked => { root.transform_field("reset", ""); } }
                                    }
                                    TimingField { label: "Position X (px)"; value: root.selected_clip_x; enabled: root.spatial_editable; committed(value) => { root.transform_field("x", value); } }
                                    TimingField { label: "Position Y (px)"; value: root.selected_clip_y; enabled: root.spatial_editable; committed(value) => { root.transform_field("y", value); } }
                                    TimingField { label: "Scale"; value: root.selected_clip_scale; enabled: root.spatial_editable; committed(value) => { root.transform_field("scale", value); } }
                                    TimingField { label: "Rotation (°)"; value: root.selected_clip_rotation; enabled: root.spatial_editable; committed(value) => { root.transform_field("rotation", value); } }
                                    ToolButton {
                                        label: root.on_spatial_key ? "Remove transform keyframe" : "Add transform keyframe"; symbol: root.on_spatial_key ? ActionSymbol.keyframe-remove : ActionSymbol.keyframe-add; show-label: true;
                                        active: root.spatial_key_enabled;
                                        clicked => { root.project_action("toggle-transform-key"); }
                                    }
                                    if root.on_spatial_key: ToolButton {
                                        label: root.eased_spatial_key ? "Use linear transform interpolation" : "Ease to next transform key"; symbol: ActionSymbol.ease; show-label: true;
                                        active: root.spatial_key_enabled;
                                        clicked => { root.project_action("ease-transform-key"); }
                                    }
                                    TimingField { label: "Opacity (%)"; value: root.selected_clip_opacity; enabled: root.opacity_editable; committed(value) => { root.transform_field("opacity", value); } }
                                    if !root.selected_clip_uses_sequence_timing: ToolButton { label: root.on_opacity_key ? "Remove opacity keyframe" : "Add opacity keyframe"; symbol: root.on_opacity_key ? ActionSymbol.keyframe-remove : ActionSymbol.keyframe-add; show-label: true; active: root.opacity_key_enabled; clicked => { root.project_action(root.on_opacity_key ? "remove-opacity-key" : "add-opacity-key"); } }
                                    TimingField { label: "Exposure (EV)"; value: root.selected_clip_exposure; enabled: root.selected_clip_writable; committed(value) => { root.transform_field("exposure", value); } }
                                    Text { text: "Crop"; color: root.text; }
                                    TimingField { label: "Crop left (%)"; value: root.crop_left; enabled: root.crop_editable; committed(value) => { root.transform_field("crop-left", value); } }
                                    TimingField { label: "Crop top (%)"; value: root.crop_top; enabled: root.crop_editable; committed(value) => { root.transform_field("crop-top", value); } }
                                    TimingField { label: "Crop right (%)"; value: root.crop_right; enabled: root.crop_editable; committed(value) => { root.transform_field("crop-right", value); } }
                                    TimingField { label: "Crop bottom (%)"; value: root.crop_bottom; enabled: root.crop_editable; committed(value) => { root.transform_field("crop-bottom", value); } }
                                    ToolButton {
                                        label: root.on_crop_key ? "Remove crop keyframe" : "Add crop keyframe"; symbol: root.on_crop_key ? ActionSymbol.keyframe-remove : ActionSymbol.keyframe-add; show-label: true;
                                        active: root.spatial_key_enabled;
                                        clicked => { root.project_action("toggle-crop-key"); }
                                    }
                                    Text { text: "Mask"; color: root.text; }
                                    ComboBox {
                                        accessible-label: "Mask shape"; model: ["None", "Rectangle", "Ellipse", "Polygon"];
                                        current-index <=> root.mask_shape; enabled: root.selected_clip_writable;
                                        selected => { root.mask_field("shape", "" + self.current-index); }
                                    }
                                    if root.mask_shape != 0: VerticalLayout {
                                        spacing: 8px;
                                        TimingField { label: "Mask center X (%)"; value: root.mask_x; enabled: root.selected_clip_writable; committed(value) => { root.mask_field("x", value); } }
                                        TimingField { label: "Mask center Y (%)"; value: root.mask_y; enabled: root.selected_clip_writable; committed(value) => { root.mask_field("y", value); } }
                                        TimingField { label: "Mask width (%)"; value: root.mask_width; enabled: root.selected_clip_writable; committed(value) => { root.mask_field("width", value); } }
                                        TimingField { label: "Mask height (%)"; value: root.mask_height; enabled: root.selected_clip_writable; committed(value) => { root.mask_field("height", value); } }
                                        TimingField { label: "Mask feather (%)"; value: root.mask_feather; enabled: root.selected_clip_writable; committed(value) => { root.mask_field("feather", value); } }
                                        if root.mask_shape == 3: TimingField {
                                            label: "Polygon vertices (x,y %)"; value: root.mask_polygon; enabled: root.selected_clip_writable;
                                            committed(value) => { root.mask_field("polygon", value); }
                                        }
                                        if root.can_track_mask && !root.mask_tracking_busy: ToolButton {
                                            label: "Track scale and rotation"; symbol: ActionSymbol.transform; show-label: true; active: root.selected_clip_writable;
                                            clicked => { root.project_action("track-mask-similarity"); }
                                        }
                                        if root.can_track_mask || root.mask_tracking_busy: ToolButton {
                                            label: root.mask_tracking_busy ? "Cancel mask tracking" : "Track mask forward"; symbol: root.mask_tracking_busy ? ActionSymbol.stop : ActionSymbol.target; show-label: true;
                                            active: root.mask_tracking_busy || root.selected_clip_writable;
                                            clicked => { root.project_action(root.mask_tracking_busy ? "cancel-mask-tracking" : "track-mask"); }
                                        }
                                        if root.has_mask_tracking: ToolButton {
                                            label: "Clear mask tracking"; symbol: ActionSymbol.close; show-label: true; active: root.selected_clip_writable && !root.mask_tracking_busy;
                                            clicked => { root.project_action("clear-mask-tracking"); }
                                        }
                                    }
                                }

                                Text { text: "Press Enter to apply a frame value. Drag a clip to move it; drag an edge to trim. Esc cancels a drag."; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                                Rectangle { vertical-stretch: 1; }
                            } }
                        }
                    }
                }
            }
            Rectangle {
                height: 280px; background: #191c1e;
                VerticalLayout {
                    spacing: 0px;
                    timeline-tools := Rectangle {
                        height: 44px;
                        min-width: 0px; preferred-width: 0px; max-width: 10000px;
                        horizontal-stretch: 1;
                        private property <bool> show-labels: true;
                        changed width => { self.show-labels = self.width >= 1320px; }
                        HorizontalLayout {
                            width: parent.width; height: parent.height; padding-left: 12px; padding-right: 12px; spacing: timeline-tools.show-labels ? 8px : 4px; cross-axis-alignment: center;
                            Text { text: "Timeline"; color: root.text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                            Rectangle { width: 1px; height: 20px; background: root.border; }
                            ToolButton { label: "ADD TRACK"; symbol: ActionSymbol.track-add; tooltip-text: "Add video track"; clicked => { editor_focus.focus(); root.track_action("", "add", ""); } }
                            Rectangle { horizontal-stretch: 1; }
                            ToolButton { label: "ADD CLIP"; symbol: ActionSymbol.add; tooltip-text: "Add selected media to timeline"; active: root.assets.length > 0; clicked => { editor_focus.focus(); root.add_to_timeline(); } }
                            ToolButton { label: "Add title"; symbol: ActionSymbol.title; show-label: timeline-tools.show-labels; clicked => { editor_focus.focus(); root.project_action("add-title"); } }
                            ToolButton { label: "Add subtitle"; symbol: ActionSymbol.subtitle; show-label: timeline-tools.show-labels; clicked => { editor_focus.focus(); root.project_action("add-subtitle"); } }
                            ToolButton { label: "Import SRT"; symbol: ActionSymbol.subtitle-import; show-label: timeline-tools.show-labels; clicked => { editor_focus.focus(); root.project_action("import-srt"); } }
                            ToolButton { label: "Export SRT"; symbol: ActionSymbol.subtitle-export; show-label: timeline-tools.show-labels; clicked => { editor_focus.focus(); root.project_action("export-srt"); } }
                            ToolButton { label: "Insert"; symbol: ActionSymbol.insert; show-label: timeline-tools.show-labels; active: root.can_place_visual; clicked => { editor_focus.focus(); root.project_action("insert"); } }
                            ToolButton { label: "Overwrite"; symbol: ActionSymbol.overwrite; show-label: timeline-tools.show-labels; active: root.can_place_visual; clicked => { editor_focus.focus(); root.project_action("overwrite"); } }
                            ToolButton { label: "SPLIT"; symbol: ActionSymbol.split; active: root.selected_clip_id != "" || (root.audio_clip_id != "" && !root.audio_clip_locked && !root.audio_clip_linked); clicked => { editor_focus.focus(); root.split_clip(); } }
                            ToolButton { label: "DELETE"; symbol: ActionSymbol.delete; tooltip-text: "Lift clip"; active: root.selected_clip_id != ""; clicked => { editor_focus.focus(); root.lift_clip(); } }
                            ToolButton { label: "Ripple delete"; symbol: ActionSymbol.ripple-delete; show-label: timeline-tools.show-labels; active: root.selected_clip_writable; clicked => { editor_focus.focus(); root.project_action("ripple-delete"); } }
                            Rectangle { width: 1px; height: 20px; background: root.border; }
                            ToolButton {
                                label: "Toggle timeline snapping"; symbol: ActionSymbol.magnet; selected: root.timeline_snap_enabled;
                                accessible-description: root.timeline_snap_enabled ? "Snapping enabled" : "Snapping disabled";
                                tooltip-text: root.timeline_snap_enabled ? "Disable timeline snapping" : "Enable timeline snapping";
                                clicked => { editor_focus.focus(); root.timeline_snap_enabled = !root.timeline_snap_enabled; }
                            }
                            ToolButton { label: "FIT TIMELINE"; symbol: ActionSymbol.fit; tooltip-text: "Fit entire sequence"; active: root.sequence_duration > 0; clicked => { root.fit_timeline(); } }
                            ToolButton { label: "ZOOM OUT"; symbol: ActionSymbol.minus; tooltip-text: "Zoom out"; active: root.timeline_zoom > 0.0001; clicked => { root.set_zoom(root.timeline_zoom > 4 ? root.timeline_zoom - 2 : root.timeline_zoom / 2); } }
                            Text { text: root.timeline_zoom >= 1 ? Math.round(root.timeline_zoom * 100) / 100 + " px/f" : Math.round(100 / root.timeline_zoom) / 100 + " f/px"; width: 88px; color: root.secondary; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
                            ToolButton { label: "ZOOM IN"; symbol: ActionSymbol.add; tooltip-text: "Zoom in"; active: root.timeline_zoom < 48; clicked => { root.set_zoom(root.timeline_zoom >= 4 ? root.timeline_zoom + 2 : root.timeline_zoom * 2); } }
                        }
                    }
                    HorizontalLayout {
                        height: 44px; spacing: 0px;
                        Rectangle { width: 112px; background: #1b1e21;
                            HorizontalLayout {
                                padding: 3px; cross-axis-alignment: center;
                                SegmentedControl {
                                    options: [
                                        { key: "", label: "Move", accessible-name: "Move clips", symbol: ActionSymbol.move },
                                        { key: "slip", label: "Slip", accessible-name: "SLIP", symbol: ActionSymbol.slip },
                                        { key: "slide", label: "Slide", accessible-name: "SLIDE", symbol: ActionSymbol.slide }
                                    ];
                                    selected-key: root.timeline_edit_mode;
                                    selected(key) => {
                                        editor_focus.focus();
                                        root.timeline_edit_mode = key == root.timeline_edit_mode ? "" : key;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1; background: #131517; clip: true;
                            for tick in Math.ceil(timeline_scroll.visible-width / 1px / max(0.0001, root.timeline_zoom) / root.ruler_step) + 2: Rectangle {
                                private property <int> frame: (tick + Math.floor(-timeline_scroll.content-x / 1px / max(0.0001, root.timeline_zoom) / root.ruler_step)) * root.ruler_step;
                                x: 10px + self.frame * root.timeline_zoom * 1px + timeline_scroll.content-x; width: 1px; height: parent.height;
                                Rectangle { width: 1px; height: 9px; y: 23px; background: #68737a; }
                                Text { x: 5px; y: 4px; width: 90px; height: 20px; text: root.ruler_label(parent.frame); color: root.secondary; font-size: 12px; vertical-alignment: center; }
                            }
                            TouchArea {
                                accessible-role: button; accessible-label: "Seek timeline ruler";
                                clicked => { editor_focus.focus(); root.seek_frame(max(0, Math.round(((self.mouse-x - timeline_scroll.content-x) / 1px - 10) / max(0.0001, root.timeline_zoom)))); }
                            }
                            for marker in root.markers: Rectangle {
                                x: 4px + marker.frame * root.timeline_zoom * 1px + timeline_scroll.content-x;
                                y: 32px; width: 13px; height: 12px;
                                background: #d1a453; border-radius: 2px;
                                TouchArea {
                                    accessible-role: button; accessible-label: "Go to " + marker.name;
                                    accessible-description: "Timeline marker at frame " + marker.frame;
                                    clicked => { editor_focus.focus(); root.seek_frame(marker.frame); }
                                }
                            }
                            Rectangle { x: 10px + root.selected_frame * root.timeline_zoom * 1px + timeline_scroll.content-x; width: 2px; height: parent.height; background: #ff525b; }
                            Rectangle { x: 6px + root.selected_frame * root.timeline_zoom * 1px + timeline_scroll.content-x; y: 1px; width: 10px; height: 10px; border-radius: 2px; background: #ff525b; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 0px; vertical-stretch: 1;
                        Rectangle {
                            width: 112px; background: #1b1e21; clip: true;
                            for track[index] in root.tracks: Rectangle {
                                y: index * 84px + timeline_scroll.content-y; height: 84px; width: parent.width;
                                background: track.selected ? #332b40 : #1b1e21;
                                border-width: 1px; border-color: root.border;
                                TouchArea { clicked => { editor_focus.focus(); root.track_action(track.id, "select", ""); } }
                                LineEdit { x: 26px; y: 8px; width: parent.width - 30px; height: 26px;
                                    text: track.name; enabled: !track.locked; accessible-label: "Name of " + track.name;
                                    accepted(value) => { root.track_action(track.id, "rename", value); }
                                }
                                ActionIcon {
                                        x: 6px; y: 13px; width: 14px; height: 14px;
                                        symbol: ActionSymbol.grip;
                                        stroke: track.locked ? root.secondary : Theme.accent-text;
                                    }
                                grip := TouchArea {
                                    x: 2px; y: 7px; width: 22px; height: 26px;
                                    enabled: !track.locked; mouse-cursor: grab;
                                    accessible-role: button; accessible-label: "Reorder " + track.name;
                                    private property <bool> armed: false;
                                    private property <length> start_y;
                                    property <int> cancel_token: root.cancel_token;
                                    changed cancel_token => { self.armed = false; root.reorder_marker = -1; }
                                    function target(y: length) -> int {
                                        return clamp(Math.round((y - timeline_scroll.absolute-position.y - timeline_scroll.content-y) / 84px), 0, root.tracks.length);
                                    }
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.cancel && self.armed { self.armed = false; root.reorder_marker = -1; root.timeline_capture(""); }
                                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                            editor_focus.focus();
                                            self.start_y = self.absolute-position.y + self.mouse-y;
                                            self.armed = true;
                                            root.timeline_capture(track.id);
                                        }
                                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && self.armed {
                                            self.armed = false;
                                            let y = self.absolute-position.y + self.mouse-y;
                                            let to = self.target(y);
                                            root.reorder_marker = -1;
                                            if abs(y - self.start_y) <= 5px { root.timeline_capture(""); root.track_action(track.id, "select", ""); }
                                            else if to != index && to != index + 1 {
                                                let last = to == root.tracks.length;
                                                root.reorder_track(track.id, root.tracks[last ? to - 1 : to].id, last);
                                            } else { root.timeline_capture(""); }
                                        }
                                    }
                                    moved => {
                                        if self.armed {
                                            let y = self.absolute-position.y + self.mouse-y;
                                            if abs(y - self.start_y) > 5px {
                                                root.edge_scroll(0px, y, false);
                                                root.reorder_marker = self.target(y);
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    y: 40px; x: 3px; width: parent.width - 6px; height: 27px; spacing: 2px;
                                    TrackButton { symbol: track.visible ? ActionSymbol.eye : ActionSymbol.eye-off; label: (track.visible ? "Hide " : "Show ") + track.name; clicked => { root.track_action(track.id, "visible", ""); } }
                                    TrackButton { symbol: track.locked ? ActionSymbol.lock : ActionSymbol.unlock; label: (track.locked ? "Unlock " : "Lock ") + track.name; clicked => { root.track_action(track.id, "lock", ""); } }
                                    TrackButton { symbol: ActionSymbol.up; label: "Move " + track.name + " up"; active: index > 0 && !track.locked; clicked => { root.track_action(track.id, "up", ""); } }
                                    TrackButton { symbol: ActionSymbol.down; label: "Move " + track.name + " down"; active: index + 1 < root.tracks.length && !track.locked; clicked => { root.track_action(track.id, "down", ""); } }
                                    TrackButton { symbol: ActionSymbol.delete; label: "Delete empty " + track.name; active: root.tracks.length > 1 && !track.locked; clicked => { root.track_action(track.id, "delete", ""); } }
                                }
                                TrackButton {
                                    x: 5px; y: 65px; width: 42px; height: 17px; symbol: ActionSymbol.sync; selected: track.sync_ripple;
                                    label: "Ripple sync " + track.name;
                                    accessible-description: track.sync_ripple ? "Ripple sync enabled" : "Ripple sync disabled";
                                    clicked => { root.track_action(track.id, "sync-ripple", ""); }
                                }
                                if !track.subtitles: ComboBox {
                                    x: 52px; y: 65px; width: parent.width - 56px; height: 18px;
                                    accessible-label: "Blend " + track.name;
                                    model: ["Normal", "Multiply", "Screen", "Overlay"];
                                    current-index: track.blend_mode; enabled: !track.locked;
                                    selected => { root.track_action(track.id, "blend", "" + self.current-index); }
                                }
                            }
                            for track[index] in root.audio_tracks: Rectangle {
                                y: (root.tracks.length + index) * 84px + timeline_scroll.content-y;
                                height: 84px; width: parent.width; background: #2f273b;
                                border-width: 1px; border-color: root.border;
                                Text { x: 8px; y: 5px; text: track.name; color: root.text; font-size: 11px; }
                                Rectangle {
                                    property <int> percent: index < root.audio_track_peaks.length ? root.audio_track_peaks[index] : 0;
                                    x: 5px; y: 23px; width: parent.width - 10px; height: 4px; background: #211b29;
                                    accessible-role: AccessibleRole.text;
                                    accessible-label: track.name + " level";
                                    accessible-description: self.percent + "%";
                                    Rectangle { width: parent.width * min(100, parent.percent) / 100; height: parent.height; background: parent.percent > 100 ? #ff796d : #b486ff; }
                                }

                                HorizontalLayout {
                                    x: 5px; y: 30px; height: 28px; width: parent.width - 10px; spacing: 3px;
                                    TrackButton { symbol: track.muted ? ActionSymbol.audio-off : ActionSymbol.audio; label: (track.muted ? "Unmute " : "Mute ") + track.name; clicked => { root.audio_track_action(track.id, "mute", ""); } }
                                    TrackButton { symbol: track.locked ? ActionSymbol.lock : ActionSymbol.unlock; label: (track.locked ? "Unlock " : "Lock ") + track.name; clicked => { root.audio_track_action(track.id, "lock", ""); } }
                                    LineEdit { text: track.gain; accessible-label: track.name + " gain (%)"; accepted(value) => { root.audio_track_action(track.id, "gain", value); } }
                                }
                                TrackButton {
                                    x: 5px; y: 64px; width: 42px; height: 17px; symbol: ActionSymbol.sync; selected: track.sync_ripple;
                                    label: "Ripple sync " + track.name;
                                    accessible-description: track.sync_ripple ? "Ripple sync enabled" : "Ripple sync disabled";
                                    clicked => { root.audio_track_action(track.id, "sync-ripple", ""); }
                                }
                                TrackButton {
                                    x: 50px; y: 64px; width: 42px; height: 17px; symbol: ActionSymbol.solo; selected: track.solo;
                                    label: "Solo " + track.name;
                                    accessible-description: track.solo ? "Solo enabled" : "Solo disabled";
                                    clicked => { root.audio_track_action(track.id, "solo", ""); }
                                }
                            }
                            if root.reorder_marker >= 0: Rectangle { y: root.reorder_marker * 84px + timeline_scroll.content-y - 1px; height: 2px; width: parent.width; background: root.accent; }
                        }
                        timeline_scroll := ScrollView {
                            horizontal-stretch: 1; vertical-stretch: 1;
                            property <float> view_left: -self.content-x / 1px;
                            property <float> view_top: -self.content-y / 1px;
                            property <float> view_width: self.visible-width / 1px;
                            property <float> view_height: self.visible-height / 1px;
                            function publish_view() { root.timeline_view_changed(self.view_left, self.view_top, self.view_width, self.view_height); }
                            changed view_left => { self.publish_view(); }
                            changed view_top => { self.publish_view(); }
                            changed view_width => { self.publish_view(); }
                            changed view_height => { self.publish_view(); }
                            content-width: max(self.visible-width, root.timeline_content_width * 1px);
                            content-height: max(self.visible-height, (root.tracks.length + root.audio_tracks.length) * 84px + 1px);
                            Rectangle {
                                width: timeline_scroll.content-width; height: timeline_scroll.content-height; background: #17191b;
                                for track[index] in root.tracks: Rectangle {
                                    y: index * 84px; height: 84px; width: parent.width;
                                    background: track.selected ? #31283d : #25212d; border-width: 1px; border-color: #30363b;
                                }
                                for track[index] in root.audio_tracks: Rectangle {
                                    y: (root.tracks.length + index) * 84px; height: 84px; width: parent.width;
                                    background: #2b2336; border-width: 1px; border-color: #49375f;
                                }
                                for tick in Math.ceil(timeline_scroll.visible-width / 1px / max(0.0001, root.timeline_zoom) / root.ruler_step) + 2: Rectangle {
                                    private property <int> frame: (tick + Math.floor(-timeline_scroll.content-x / 1px / max(0.0001, root.timeline_zoom) / root.ruler_step)) * root.ruler_step;
                                    x: 10px + self.frame * root.timeline_zoom * 1px; width: 1px; height: parent.height; background: #282f32;
                                }
                                TouchArea {
                                    clicked => { editor_focus.focus(); root.seek_frame(max(0, Math.round((self.mouse-x / 1px - 10) / max(0.0001, root.timeline_zoom)))); }
                                }
                                for clip in root.timeline_video_clips: TimelineClip {
                                    item: clip; zoom: root.timeline_zoom; cancel_token: root.cancel_token; scroll_x: timeline_scroll.content-x;
                                    focused => { editor_focus.focus(); root.timeline_capture(clip.id); }
                                    cancelled => { root.timeline_capture(""); }
                                    edit_mode: root.nodes_open ? "" : root.timeline_edit_mode;
                                    part_of_group: root.selection_size > 1 && clip.selected;
                                    group_delta: root.group_preview_delta;
                                    group_preview(delta) => { root.group_preview_delta = delta; }
                                    clicked(additive) => { if additive && !root.nodes_open { root.clip_select_more(clip.id); } else { root.clip_select(clip.id); } }
                                    gesture(kind, delta, track) => { root.clip_gesture(clip.id, kind, delta, track); }
                                    target_lane(y) => { return root.target_lane(y); }
                                    lane_id(lane) => { return root.lane_id(lane); }
                                    drop_error(track, delta) => { return root.clip_drop_error(clip.id, track, delta); }
                                    snapped_delta(kind, delta, track) => {
                                        if !root.timeline_snap_enabled {
                                            return delta;
                                        }
                                        let snap = root.clip_snap(clip.id, kind, delta, track, root.timeline_zoom);
                                        root.timeline_snap_frame = snap.frame;
                                        return snap.delta;
                                    }
                                    clear_snap => { root.timeline_snap_frame = -1; }
                                    autoscroll(x, y) => { root.edge_scroll(x, y, true); }
                                }
                                for clip in root.timeline_audio_clips: AudioTimelineClip {
                                    item: clip; video_lanes: root.tracks.length;
                                    zoom: root.timeline_zoom; scroll_x: timeline_scroll.content-x; cancel_token: root.cancel_token;
                                    capture => { editor_focus.focus(); root.timeline_capture(clip.id); }
                                    clicked => { editor_focus.focus(); root.audio_clip_action(clip.id, "select", ""); }
                                    cancelled => { root.timeline_capture(""); }
                                    gesture(kind, delta) => { root.audio_clip_gesture(clip.id, kind, delta); }
                                    autoscroll(x, y) => { root.edge_scroll(x, y, false); }
                                }
                                for dissolve in root.dissolves: Rectangle {
                                    x: 10px + dissolve.start * root.timeline_zoom * 1px;
                                    y: dissolve.lane * 84px + 61px;
                                    width: max(2px, dissolve.duration * root.timeline_zoom * 1px);
                                    height: 15px; border-radius: 2px; background: #906335;
                                    accessible-role: groupbox; accessible-label: "Dissolve";
                                    accessible-description: dissolve.description;
                                    Text { text: "Dissolve"; width: parent.width; height: parent.height; color: #fff1d8; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                }
                                Rectangle { x: 10px + root.selected_frame * root.timeline_zoom * 1px; width: 2px; height: parent.height; background: #ff525b; }
                                if root.timeline_snap_frame >= 0: Rectangle {
                                    x: 10px + root.timeline_snap_frame * root.timeline_zoom * 1px;
                                    width: 2px; height: parent.height; background: #f2c96d;
                                    accessible-role: groupbox;
                                    accessible-label: "Snap guide";
                                    accessible-description: "Frame " + root.timeline_snap_frame;
                                }
                                if root.reorder_marker >= 0: Rectangle { y: root.reorder_marker * 84px - 1px; height: 2px; width: parent.width; background: root.accent; }
                            }
                        }
                    }
                    if root.motion_open: VerticalLayout {
                        height: 104px + (root.motion_has_curve && root.motion_curve_index == 3 ? 65px : 0px) + (root.motion_effect_visible ? 36px : 0px); spacing: 4px; padding: 6px;
                        HorizontalLayout {
                            spacing: 5px;
                            ComboBox {
                                width: 126px; model: root.motion_channels;
                                accessible-label: "Animation property";
                                current-index <=> root.motion_channel_index;
                                selected => { root.motion_action("channel", self.current-index, 0, false); }
                            }
                            ToolButton { label: "Copy keyframes"; symbol: ActionSymbol.copy; active: root.motion_has_selection; clicked => { root.motion_action("copy", 0, 0, false); } }
                            ToolButton { label: "Paste keyframes"; symbol: ActionSymbol.paste; active: root.motion_can_paste && root.motion_writable; clicked => { root.motion_action("paste", 0, 0, false); } }
                            ToolButton { label: "Delete keyframes"; symbol: ActionSymbol.delete; active: root.motion_has_selection && root.motion_writable; clicked => { root.motion_action("delete", 0, 0, false); } }
                            if root.motion_has_curve: ComboBox {
                                width: 108px; model: ["Hold", "Linear", "Smooth", "Bezier"];
                                enabled: root.motion_writable;
                                accessible-label: "Keyframe interpolation";
                                current-index <=> root.motion_curve_index;
                                selected => { root.motion_action("curve", self.current-index, 0, false); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.motion_has_curve && root.motion_curve_index == 3: Rectangle {
                            height: 60px; background: #252c30;
                            curve_plot := Rectangle {
                                x: 9px; width: 152px; height: 60px;
                                accessible-role: groupbox; accessible-label: "Bezier curve";
                                property <float> saved_x1: root.motion_x1;
                                property <float> saved_y1: root.motion_y1;
                                property <float> saved_x2: root.motion_x2;
                                property <float> saved_y2: root.motion_y2;
                                property <float> x1: root.motion_x1;
                                property <float> y1: root.motion_y1;
                                property <float> x2: root.motion_x2;
                                property <float> y2: root.motion_y2;
                                changed saved_x1 => { self.x1 = self.saved_x1; }
                                changed saved_y1 => { self.y1 = self.saved_y1; }
                                changed saved_x2 => { self.x2 = self.saved_x2; }
                                changed saved_y2 => { self.y2 = self.saved_y2; }
                                Path {
                                    width: parent.width; height: parent.height;
                                    viewbox-width: 152; viewbox-height: 60;
                                    fill: transparent; stroke: root.accent; stroke-width: 1px;
                                    commands: "M0 60 C" + curve_plot.x1 * 152 + " " + (1 - curve_plot.y1) * 60 + " " +
                                        curve_plot.x2 * 152 + " " + (1 - curve_plot.y2) * 60 + " 152 0";
                                }
                                for handle in 2: Rectangle {
                                    x: (handle == 0 ? curve_plot.x1 : curve_plot.x2) * parent.width - self.width / 2;
                                    y: (1 - (handle == 0 ? curve_plot.y1 : curve_plot.y2)) * parent.height - self.height / 2;
                                    width: 12px; height: 12px; background: #ffd789; border-radius: 6px;
                                    TouchArea {
                                        accessible-role: button;
                                        accessible-label: handle == 0 ? "First Bezier handle" : "Second Bezier handle";
                                        enabled: root.motion_writable;
                                        function update_curve() {
                                            let x = (self.absolute-position.x + self.mouse-x - curve_plot.absolute-position.x) / curve_plot.width;
                                            let y = 1 - (self.absolute-position.y + self.mouse-y - curve_plot.absolute-position.y) / curve_plot.height;
                                            if handle == 0 { curve_plot.x1 = clamp(x, 0, curve_plot.x2); curve_plot.y1 = clamp(y, 0, 1); }
                                            else { curve_plot.x2 = clamp(x, curve_plot.x1, 1); curve_plot.y2 = clamp(y, 0, 1); }
                                        }
                                        property <bool> armed;
                                        property <int> cancel_token: root.cancel_token;
                                        changed cancel_token => { self.abort_curve(); }
                                        function abort_curve() {
                                            self.armed = false;
                                            curve_plot.x1 = root.motion_x1; curve_plot.y1 = root.motion_y1;
                                            curve_plot.x2 = root.motion_x2; curve_plot.y2 = root.motion_y2;
                                        }
                                        moved => { if self.pressed && self.armed { self.update_curve(); } }
                                        pointer-event(event) => {
                                            if event.kind == PointerEventKind.cancel { self.abort_curve(); }
                                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                                self.armed = true;
                                                editor_focus.focus();
                                            }
                                            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && self.armed {
                                                self.armed = false;
                                                self.update_curve();
                                                root.motion_curve_handle(handle, handle == 0 ? curve_plot.x1 : curve_plot.x2,
                                                    handle == 0 ? curve_plot.y1 : curve_plot.y2);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.motion_effect_visible: HorizontalLayout {
                            spacing: 5px;
                            ToolButton {
                                label: root.motion_effect_key_here ? "Remove effect keyframe" : "Add effect keyframe"; symbol: root.motion_effect_key_here ? ActionSymbol.keyframe-remove : ActionSymbol.keyframe-add; show-label: true;
                                active: root.motion_writable;
                                clicked => { root.motion_effect_key(""); }
                            }
                            LineEdit {
                                width: 100px; accessible-label: "Effect keyframe value";
                                text: root.motion_effect_value; enabled: root.motion_writable;
                                accepted(value) => { root.motion_effect_key(value); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        key_rail := Rectangle {
                            background: #22292d; border-radius: 4px; vertical-stretch: 1;
                            accessible-role: groupbox; accessible-label: "Clip keyframe track";
                            property <float> scale: max(0.0001, (self.width - 24px) / 1px / max(1, root.motion_duration - 1));
                            Rectangle { x: 12px; y: parent.height / 2; width: parent.width - 24px; height: 1px; background: #7d708d; }
                            for key in root.motion_keys: Rectangle {
                                property <int> offset: 0;
                                x: 5px + (key.frame - root.motion_start + self.offset) * key_rail.scale * 1px;
                                y: (parent.height - self.height) / 2; width: 14px; height: 22px;
                                ActionIcon {
                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                    width: 12px; height: 12px;
                                    symbol: ActionSymbol.keyframe;
                                    stroke: key.selected ? #ffd789 : Theme.accent-text;
                                    fill: key.selected ? #ffd789 : Theme.accent-text;
                                }
                                ClipGestureArea {
                                    zoom: key_rail.scale; cancel_token: root.cancel_token;
                                    accessible-role: button; accessible-label: "Keyframe " + key.frame;
                                    accessible-description: key.selected ? "Selected" : "Unselected";
                                    began => { editor_focus.focus(); }
                                    preview(delta, x, y) => { if root.motion_writable { parent.offset = delta; } }
                                    finished(delta, x, y) => {
                                        parent.offset = 0;
                                        if delta != 0 && root.motion_writable { root.motion_action("move", key.index, delta, false); }
                                        else { root.motion_action("select", key.index, 0, self.additive); }
                                    }
                                    cancelled => { parent.offset = 0; }
                                }
                            }
                        }
                    }
                    Rectangle { height: 30px; background: #151719; HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: root.clips.length + " video · " + root.audio_clips.length + " audio · " + root.sequence_duration + " frames"; color: root.secondary; font-size: 11px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } if root.selection_size > 1: Text { text: root.selection_size + " selected"; color: Theme.accent-text; font-size: 11px; vertical-alignment: center; }
                        ToolButton {
                            label: root.motion_open ? "Hide keyframes" : "Show keyframes"; symbol: ActionSymbol.keyframe; show-label: true; selected: root.motion_open;
                            active: root.selected_clip_id != "";
                            clicked => { editor_focus.focus(); root.motion_action("toggle", 0, 0, false); }
                        }
                        if root.marker_here: LineEdit { width: 156px; text: root.marker_name; accessible-label: "Marker name"; accepted(value) => { root.marker_name_changed(value); } }
                        ToolButton { label: root.marker_here ? "Remove marker" : "Add marker"; symbol: root.marker_here ? ActionSymbol.marker-remove : ActionSymbol.marker-add; show-label: true; active: root.sequence_duration > 0; clicked => { editor_focus.focus(); root.project_action("toggle-marker"); } }
                        Text { text: root.audio_level; color: root.secondary; font-size: 11px; vertical-alignment: center; } } }
                }
            }
            Rectangle { height: 26px; background: #121415; HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 12px; Text { text: root.export_status == "" ? root.project_status : root.export_status; color: #939ba2; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; } Text { text: root.project_data_width + " × " + root.project_data_height + " · " + root.sequence_fps + " fps"; color: #939ba2; font-size: 11px; vertical-alignment: center; } } }
        }
        if root.grades_open: Rectangle {
            width: parent.width; height: parent.height; background: #000000b0;
            TouchArea { clicked => { root.grades_open = false; editor_focus.focus(); } }
            Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: 410px; height: 256px; background: root.panel;
                border-width: 1px; border-color: root.border; border-radius: 10px;
                TouchArea { }
                VerticalLayout {
                    padding: 18px; spacing: 8px;
                    Text { text: "Grade versions"; color: root.text; font-size: 18px; font-weight: 700; }
                    ComboBox {
                        accessible-label: "Grade version"; model: root.grade_names;
                        current-index <=> root.grade_index;
                        selected => { root.grade_action("select", self.current-index, ""); }
                    }
                    LineEdit {
                        property <string> label: root.grade_name;
                        text: self.label; accessible-label: "Grade version name";
                        changed label => { self.text = self.label; }
                        accepted(text) => { root.grade_action("rename", 0, text); }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        ToolButton { label: "Duplicate grade"; symbol: ActionSymbol.copy; show-label: true; clicked => { root.grade_action("duplicate", 0, ""); } }
                        ToolButton { label: "Remove grade"; symbol: ActionSymbol.delete; show-label: true; active: root.grade_names.length > 1; clicked => { root.grade_action("remove", 0, ""); } }
                        ToolButton { label: "Close versions"; symbol: ActionSymbol.close; clicked => { root.grades_open = false; editor_focus.focus(); } }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        ToolButton { label: "Copy grade"; symbol: ActionSymbol.copy; show-label: true; clicked => { root.grade_action("copy", 0, ""); } }
                        ToolButton { label: "Paste grade"; symbol: ActionSymbol.paste; show-label: true; active: root.grade_can_paste && root.selected_clip_writable; clicked => { root.grade_action("paste", 0, ""); } }
                    }
                }
            }
        }
        if root.delivery_queue_open: Rectangle {
            width: parent.width; height: parent.height; background: #000000b0;
            TouchArea { clicked => { root.delivery_queue_open = false; editor_focus.focus(); } }
            Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: min(700px, parent.width - 34px); height: min(460px, parent.height - 40px);
                background: root.panel; border-width: 1px; border-color: root.border; border-radius: 10px;
                TouchArea { }
                VerticalLayout {
                    padding: 18px; spacing: 10px;
                    Text { text: "Render queue"; color: root.text; font-size: 18px; font-weight: 700; }
                    if root.delivery_jobs.length == 0: Text { text: "Use Add to queue in the MP4 export dialog."; color: root.secondary; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            for job[index] in root.delivery_jobs: Rectangle {
                                height: 64px; background: #22292c; border-radius: 5px;
                                accessible-role: groupbox; accessible-label: "Delivery " + job.path;
                                accessible-description: job.phase + " · " + job.details;
                                HorizontalLayout {
                                    padding: 8px; spacing: 6px;
                                    VerticalLayout {
                                        horizontal-stretch: 1; spacing: 4px;
                                        Text { text: job.phase + " · " + job.path; color: root.text; overflow: elide; font-size: 12px; }
                                        Text { text: job.details; color: root.secondary; overflow: elide; font-size: 11px; }
                                    }
                                    if job.can_cancel: ToolButton { label: "Cancel job"; symbol: ActionSymbol.stop; show-label: true; clicked => { root.delivery_queue_action("cancel", index); } }
                                    if job.can_retry: ToolButton { label: "Retry job"; symbol: ActionSymbol.history; show-label: true; clicked => { root.delivery_queue_action("retry", index); } }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        ToolButton { label: "Close queue"; symbol: ActionSymbol.close; clicked => { root.delivery_queue_open = false; editor_focus.focus(); } }
                        ToolButton { label: "Start render queue"; symbol: ActionSymbol.play; show-label: true; active: root.delivery_can_start; primary: true; clicked => { root.delivery_queue_action("start", 0); } }
                    }
                }
            }
        }
        if root.settings_open: Rectangle {
            width: parent.width; height: parent.height; background: #000000b0;
            TouchArea { clicked => { root.settings_open = false; editor_focus.focus(); } }
            Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: 480px; height: 732px; background: root.panel;
                border-width: 1px; border-color: root.border; border-radius: 10px;
                TouchArea { }
                VerticalLayout {
                    padding: 24px; spacing: 10px;
                    Text { text: "Sequence settings"; color: root.text; font-size: 18px; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 6px;
                        ComboBox {
                            accessible-label: "Active sequence"; model: root.sequence_names;
                            current-index <=> root.sequence_choice;
                            selected => { root.sequence_slot("select", self.current-index, ""); }
                        }
                        ToolButton { label: "New sequence"; symbol: ActionSymbol.add; show-label: true; clicked => { root.sequence_slot("create", 0, ""); } }
                        ToolButton { label: "Duplicate sequence"; symbol: ActionSymbol.copy; show-label: true; clicked => { root.sequence_slot("duplicate", 0, ""); } }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        ToolButton { label: "Import OTIO"; symbol: ActionSymbol.import-file; show-label: true; clicked => { root.settings_open = false; root.project_action("import-otio"); } }
                        ToolButton { label: "Audio delivery"; symbol: ActionSymbol.audio; show-label: true; clicked => { root.settings_open = false; root.project_action("deliver-audio"); } }
                        ToolButton { label: "ProRes master"; symbol: ActionSymbol.film; show-label: true; clicked => { root.settings_open = false; root.project_action("export-master"); } }
                        ToolButton { label: "Export OTIO"; symbol: ActionSymbol.export-file; show-label: true; clicked => { root.settings_open = false; root.project_action("export-otio"); } }
                    }
                    if root.camera_angles.length > 0: HorizontalLayout {
                        spacing: 8px;
                        ToolButton { label: "Camera angles"; symbol: ActionSymbol.camera; show-label: true; active: root.camera_angles.length > 1; clicked => { root.settings_open = false; editor_focus.focus(); root.project_action("camera-monitor"); } }
                        ToolButton { label: "Clear camera sync"; symbol: ActionSymbol.unlink; show-label: true; clicked => { root.settings_open = false; root.project_action("clear-cameras"); } }
                    }
                    LineEdit {
                        property <string> sequence_label: root.active_sequence_name;
                        text: self.sequence_label; accessible-label: "Sequence name";
                        changed sequence_label => { self.text = self.sequence_label; }
                        accepted(value) => { root.sequence_slot("rename", 0, value); }
                    }
                    if root.nested_source_names.length > 0: HorizontalLayout {
                        spacing: 6px;
                        ComboBox {
                            accessible-label: "Nested sequence source"; model: root.nested_source_names;
                            current-index <=> root.nested_source_choice;
                        }
                        ToolButton {
                            label: "Nest at playhead"; symbol: ActionSymbol.layers; show-label: true;
                            clicked => { root.sequence_slot("nest", root.nested_source_choice, ""); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        TimingField { label: "Timeline exposure (EV)"; value: root.sequence_exposure; enabled: true; committed(value) => { root.shared_grade(false, "exposure", value); } }
                        TimingField { label: "Timeline saturation (%)"; value: root.sequence_saturation; enabled: true; committed(value) => { root.shared_grade(false, "saturation", value); } }
                    }
                    if root.grade_track_name != "": VerticalLayout {
                        Text { text: "Track grade ? " + root.grade_track_name; color: root.secondary; }
                        HorizontalLayout {
                            spacing: 6px;
                            TimingField { label: "Track exposure (EV)"; value: root.group_exposure; enabled: true; committed(value) => { root.shared_grade(true, "exposure", value); } }
                            TimingField { label: "Track saturation (%)"; value: root.group_saturation; enabled: true; committed(value) => { root.shared_grade(true, "saturation", value); } }
                        }
                    }
                    CheckBox {
                        text: "Managed color · ACEScg";
                        checked <=> root.sequence_managed_color;
                        toggled => { root.managed_color_changed(self.checked); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        ToolButton {
                            label: "Toggle HDR monitor"; symbol: ActionSymbol.monitor; show-label: true;
                            active: root.sequence_managed_color || root.hdr_monitor_status != "HDR monitor closed";
                            clicked => { root.toggle_hdr_monitor(); root.settings_open = false; }
                        }
                        Text { text: root.hdr_monitor_status; color: root.secondary; vertical-alignment: center; }
                    }
                    Text { text: "Frame dimensions and rational frame rate. Enter whole numbers; the project validates changes."; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                    Text { text: "Width (pixels)"; color: root.secondary; font-size: 12px; }
                    LineEdit { accessible-label: "Sequence width"; text <=> root.draft_width; }
                    Text { text: "Height (pixels)"; color: root.secondary; font-size: 12px; }
                    LineEdit { accessible-label: "Sequence height"; text <=> root.draft_height; }
                    Text { text: "FPS numerator / denominator (e.g. 30000 / 1001)"; color: root.secondary; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 10px;
                        LineEdit { accessible-label: "FPS numerator"; text <=> root.draft_fps_numerator; }
                        Text { text: "/"; color: root.secondary; vertical-alignment: center; }
                        LineEdit { accessible-label: "FPS denominator"; text <=> root.draft_fps_denominator; }
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 10px;
                        ToolButton { label: "Cancel"; symbol: ActionSymbol.close; show-label: true; clicked => { root.settings_open = false; editor_focus.focus(); } }
                        ToolButton { label: "Apply settings"; symbol: ActionSymbol.check; show-label: true; primary: true; clicked => { root.sequence_settings(root.draft_width, root.draft_height, root.draft_fps_numerator, root.draft_fps_denominator); root.settings_open = false; editor_focus.focus(); } }
                    }
                }
            }
        }
        if root.transcript_open: Rectangle {
            width: parent.width; height: parent.height; background: #000000b0;
            accessible-role: groupbox; accessible-label: "Transcript";
            TouchArea {}
            Rectangle {
                width: min(parent.width - 40px, 720px); height: min(parent.height - 40px, 550px);
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                background: root.panel; border-radius: 8px;
                VerticalLayout {
                    padding: 16px; spacing: 10px;
                    Text { text: root.transcript_busy ? "Transcribing locally…" : "Transcript"; color: root.text; }
                    LineEdit {
                        accessible-label: "Search transcript"; placeholder-text: "Search transcript";
                        text <=> root.transcript_query;
                        edited(value) => { root.transcript_action("search", -1, value); }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 8px;
                            for row in root.transcript_rows: HorizontalLayout {
                                spacing: 8px;
                                CheckBox {
                                    text: "Keep segment " + (row.index + 1); checked: row.checked;
                                    toggled => { root.transcript_action("toggle", row.index, ""); }
                                }
                                Button {
                                    text: row.label; horizontal-stretch: 1;
                                    clicked => { root.transcript_action("seek", row.index, ""); }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        ToolButton {
                            label: root.transcript_busy ? "Cancel transcription" : "Close transcript"; symbol: root.transcript_busy ? ActionSymbol.stop : ActionSymbol.close; show-label: true;
                            clicked => { root.transcript_action("close", -1, ""); editor_focus.focus(); }
                        }
                        ToolButton {
                            label: "Create rough cut with subtitles"; symbol: ActionSymbol.subtitle; show-label: true; primary: true; active: root.transcript_can_build;
                            clicked => { root.transcript_action("build", -1, ""); editor_focus.focus(); }
                        }
                    }
                }
            }
        }
        if root.file_dialog_open: Rectangle {
            width: parent.width; height: parent.height; background: #000000b0;
            accessible-role: groupbox;
            accessible-label: "File dialog";
            accessible-description: "Action " + root.file_dialog_kind + "; path " + root.file_path;
            TouchArea { clicked => { root.file_dialog_open = false; editor_focus.focus(); } }
            Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: 680px; height: root.file_dialog_kind == "deliver-audio" ? 365px : root.file_dialog_kind == "import-files" ? 370px : root.file_dialog_kind == "export" ? 390px : (root.file_dialog_kind == "export-srt" || root.file_dialog_kind == "export-master") ? 318px : 264px; background: root.panel;
                border-width: 1px; border-color: root.border; border-radius: 10px;
                TouchArea { }
                VerticalLayout {
                    padding: 24px; spacing: 12px;
                    Text { text: root.file_dialog_kind == "deliver-audio" ? "Deliver audio" : root.file_dialog_kind == "import-otio" ? "Import timeline" : root.file_dialog_kind == "export-otio" ? "Export timeline" : root.file_dialog_kind == "export-master" ? "Export ProRes 422 HQ" : root.file_dialog_kind == "import-files" ? "Import multiple files" : root.file_dialog_kind == "relink-folder" ? "Find offline originals" : root.file_dialog_kind == "lut" ? "Load CUBE LUT" : root.file_dialog_kind == "srt" ? "Import subtitles" : root.file_dialog_kind == "export-srt" ? "Export subtitles" : root.file_dialog_kind == "import" ? "Import media" : root.file_dialog_kind == "open" ? "Open project" : root.file_dialog_kind == "save-as" ? "Save project as" : root.file_dialog_kind == "export" ? "Export sequence" : "Relink missing media"; color: root.text; font-size: 18px; font-weight: 700; }
                    Text { text: root.file_dialog_kind == "import-files" ? "Paste one full file path per line, or use Browse." : root.file_dialog_kind == "relink-folder" ? "Paste a folder path, or use Browse to choose a folder." : "Paste a full local file path, or use Browse to choose a file."; color: root.secondary; font-size: 11px; }
                    if root.file_dialog_kind == "export": Text {
                        text: (root.export_profile == 1 ? "HEVC Main10 · declared BT.2020 / 1000-nit target" : root.export_profile == 2 ? "HEVC Main10 · BT.2020 HLG" : "H.264 MP4") + (root.audio_clips.length > 0 ? " + stereo AAC" : "") + " · Sequence ends at frame " + root.sequence_duration;
                        color: root.secondary; font-size: 11px;
                    }
                    if root.file_dialog_kind == "export" || root.file_dialog_kind == "export-srt" || root.file_dialog_kind == "export-master" || root.file_dialog_kind == "deliver-audio": HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Start frame"; color: root.secondary; font-size: 12px; }
                            LineEdit { text <=> root.export_start_frame; accessible-label: "Export start frame"; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "End frame (exclusive)"; color: root.secondary; font-size: 12px; }
                            LineEdit { text <=> root.export_end_frame; accessible-label: "Export end frame (exclusive)"; }
                        }
                    }
                    if root.file_dialog_kind == "deliver-audio": HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            Text { text: "Target LUFS"; color: root.secondary; }
                            LineEdit { text <=> root.delivery_target; accessible-label: "Target LUFS"; }
                        }
                        VerticalLayout {
                            Text { text: "Ceiling dBTP"; color: root.secondary; }
                            LineEdit { text <=> root.delivery_peak; accessible-label: "True peak ceiling"; }
                        }
                        CheckBox { text: "Export stems"; checked <=> root.delivery_stems; }
                    }
                    if root.file_dialog_kind == "export": HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Output color"; color: root.secondary; font-size: 12px; }
                            ComboBox { accessible-label: "Export color profile"; current-index <=> root.export_profile;
                                model: ["SDR Rec.709", "HDR10 PQ · BT.2020 / 1000 nits", "HLG · BT.2020"]; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Resolution"; color: root.secondary; font-size: 12px; }
                            ComboBox { accessible-label: "Export resolution"; current-index <=> root.export_resolution; model: ["Sequence size", "Fit 720p", "Fit 1080p", "Fit UHD"]; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Frame rate"; color: root.secondary; font-size: 12px; }
                            ComboBox { accessible-label: "Export frame rate"; current-index <=> root.export_frame_rate; model: ["Sequence rate", "24 fps", "25 fps", "30 fps", "60 fps"]; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Bitrate"; color: root.secondary; font-size: 12px; }
                            ComboBox { accessible-label: "Export bitrate"; current-index <=> root.export_quality; model: ["Standard", "Compact", "High"]; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        if root.file_dialog_kind == "import-files": TextEdit {
                            height: 140px;
                            accessible-label: "Import file paths";
                            text <=> root.file_path;
                        }
                        if root.file_dialog_kind != "import-files": LineEdit {
                            accessible-label: "File path";
                            text <=> root.file_path;
                            placeholder-text: root.file_dialog_kind == "deliver-audio" ? "/path/to/delivery.audio" : root.file_dialog_kind == "export-master" ? "/path/to/master.mov" : root.file_dialog_kind == "import-otio" || root.file_dialog_kind == "export-otio" ? "/path/to/timeline.otio" : root.file_dialog_kind == "lut" ? "/path/to/grade.cube" : root.file_dialog_kind == "srt" || root.file_dialog_kind == "export-srt" ? "/path/to/subtitles.srt" : root.file_dialog_kind == "import" || root.file_dialog_kind == "relink" ? "/path/to/media" : root.file_dialog_kind == "export" ? "/path/to/video.mp4" : "/path/to/project.oqvideo.json";
                            accepted(value) => { root.submit_file(); }
                        }
                        ToolButton { label: "Browse…"; symbol: ActionSymbol.folder; show-label: true; clicked => { root.project_action("browse-" + root.file_dialog_kind); } }
                    }
                    Text { text: root.io_status; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle { horizontal-stretch: 1; }
                        ToolButton { label: "Cancel"; symbol: ActionSymbol.close; show-label: true; clicked => { root.file_dialog_open = false; editor_focus.focus(); } }
                        if root.file_dialog_kind == "export": ToolButton {
                            label: "Add to queue"; symbol: ActionSymbol.queue; show-label: true;
                            clicked => { root.file_dialog_open = false; editor_focus.focus(); root.file_submit("queue-export", root.file_path); }
                        }
                        ToolButton { label: root.file_dialog_kind == "deliver-audio" ? "Save audio delivery" : root.file_dialog_kind == "export-master" ? "Save ProRes master" : root.file_dialog_kind == "import-otio" ? "Open OTIO timeline" : root.file_dialog_kind == "export-otio" ? "Save OTIO timeline" : root.file_dialog_kind == "import-files" ? "Import selected files" : root.file_dialog_kind == "relink-folder" ? "Search folder" : root.file_dialog_kind == "save-as" ? "Save project" : root.file_dialog_kind == "open" ? "Open project" : root.file_dialog_kind == "relink" ? "Relink media" : root.file_dialog_kind == "export" ? "Export MP4" : root.file_dialog_kind == "export-srt" ? "Save SRT" : root.file_dialog_kind == "lut" ? "Load CUBE LUT" : root.file_dialog_kind == "srt" ? "Import subtitles" : "Import media"; symbol: root.file_dialog_kind == "export" || root.file_dialog_kind == "export-srt" || root.file_dialog_kind == "export-otio" ? ActionSymbol.export-file : root.file_dialog_kind == "save-as" || root.file_dialog_kind == "deliver-audio" || root.file_dialog_kind == "export-master" ? ActionSymbol.save : root.file_dialog_kind == "open" || root.file_dialog_kind == "relink-folder" ? ActionSymbol.folder : ActionSymbol.import-file; show-label: true; primary: true; clicked => { root.submit_file(); } }
                    }
                }
            }
        }
    }
}
